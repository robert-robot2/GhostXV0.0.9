<!-- ===================================================
     PHASE 10 JAVASCRIPT
     =================================================== -->
<script>
(function() {
    'use strict';
    const get = id => document.getElementById(id);
    const fmtK = n => Math.abs(n) >= 1000 ? (n/1000).toFixed(1)+'k' : Math.round(n).toString();
    const setText = (id, v) => { const e = get(id); if (e) e.textContent = v; };
    const setW = (id, pct) => { const e = get(id); if (e) e.style.width = Math.min(100, Math.max(0, pct))+'%'; };

    // PSI → Pascals
    const psiToPa = psi => psi * 6894.76;

    function calcGen(psi, boreMm, strokeMm, pcount, rpm, mechEff, genEff) {
        const r = (boreMm / 2) / 1000; // metres
        const area = Math.PI * r * r;
        const force = psiToPa(psi) * area; // N per piston
        const crankRadius = (strokeMm / 2) / 1000; // metres
        const torquePerPiston = force * crankRadius;
        const totalTorque = torquePerPiston * pcount;
        const omega = (rpm * 2 * Math.PI) / 60;
        const shaftPowerW = totalTorque * omega;
        const genOutputW = shaftPowerW * mechEff * genEff;
        return { force, totalTorque, shaftPowerW, genOutputW };
    }

    // ── EXPERIMENT CALCULATOR ──
    const expSliders = [
        { id: 'p10-psi',      out: 'p10-psi-out',     fmt: v => v+' PSI' },
        { id: 'p10-bore',     out: 'p10-bore-out',     fmt: v => v+' mm' },
        { id: 'p10-stroke',   out: 'p10-stroke-out',   fmt: v => v+' mm' },
        { id: 'p10-pcount',   out: 'p10-pcount-out',   fmt: v => v },
        { id: 'p10-rpm',      out: 'p10-rpm-out',      fmt: v => v+' RPM' },
        { id: 'p10-mech-eff', out: 'p10-meff-out',     fmt: v => v+'%' },
        { id: 'p10-gen-eff',  out: 'p10-geff-out',     fmt: v => v+'%' },
        { id: 'p10-demand',   out: 'p10-demand-out',   fmt: v => (+v).toLocaleString()+' W' },
        { id: 'p10-soc',      out: 'p10-soc-out',      fmt: v => v+'%' },
        { id: 'p10-teg',      out: 'p10-teg-out',      fmt: v => (+v).toLocaleString()+' W' },
    ];

    expSliders.forEach(s => {
        const el = get(s.id);
        if (!el) return;
        el.addEventListener('input', () => {
            const out = get(s.out); if (out) out.textContent = s.fmt(el.value);
            recalcExp();
        });
    });

    function recalcExp() {
        const psi     = +(get('p10-psi')?.value      || 150);
        const bore    = +(get('p10-bore')?.value     || 80);
        const stroke  = +(get('p10-stroke')?.value   || 120);
        const pcount  = +(get('p10-pcount')?.value   || 6);
        const rpm     = +(get('p10-rpm')?.value      || 300);
        const mechEff = +(get('p10-mech-eff')?.value || 50) / 100;
        const genEff  = +(get('p10-gen-eff')?.value  || 80) / 100;
        const demand  = +(get('p10-demand')?.value   || 4200);
        const teg     = +(get('p10-teg')?.value      || 800);

        const { force, totalTorque, shaftPowerW, genOutputW } = calcGen(psi, bore, stroke, pcount, rpm, mechEff, genEff);
        const totalIn = genOutputW + teg;
        const net = totalIn - demand;
        const sustained = net >= 0;
        const sustainPct = Math.round((totalIn / demand) * 100);

        setText('p10-r-force',  (force/1000).toFixed(1)+' kN');
        setText('p10-r-torque', Math.round(totalTorque).toLocaleString()+' Nm');
        setText('p10-r-shaft',  (shaftPowerW/1000).toFixed(1)+' kW');
        setText('p10-r-gen',    fmtK(genOutputW)+' W');
        setText('p10-r-net',    (net>=0?'+':'')+fmtK(net)+' W');
        setText('p10-r-verdict',sustained ? '✓ CONFIRMED' : '✗ NOT YET');

        const vEl = get('p10-r-verdict');
        if (vEl) vEl.style.color = sustained ? '#00FFD1' : '#DC143C';

        setW('p10-sustain-bar', sustainPct);
        setText('p10-sustain-pct', sustainPct+'%');

        const norm = v => Math.min(100, Math.round((v/Math.max(1,demand))*100));
        setW('p10-bb-gen', norm(genOutputW));
        setW('p10-bb-teg', norm(teg));
        setW('p10-bb-net', norm(Math.abs(net)));

        setText('p10-bv-demand', fmtK(demand)+' W');
        setText('p10-bv-gen',    fmtK(genOutputW)+' W');
        setText('p10-bv-teg',    fmtK(teg)+' W');
        setText('p10-bv-net',    (net>=0?'+':'')+fmtK(net)+' W');

        // Result box
        const box   = get('p10-result-box');
        const icon  = get('p10-result-icon');
        const title = get('p10-result-title');
        const desc  = get('p10-result-desc');
        if (box && icon && title && desc) {
            if (sustained) {
                box.style.borderColor  = '#00FFD1';
                box.style.background   = 'rgba(0,255,209,0.05)';
                icon.textContent  = '✅';
                title.textContent = 'HYPOTHESIS CONFIRMED — Generator sustains boiler';
                title.style.color = '#00FFD1';
                desc.textContent  = `At ${psi} PSI / ${rpm} RPM the generator produces ${Math.round(genOutputW).toLocaleString()}W plus ${teg.toLocaleString()}W TEG = ${Math.round(totalIn).toLocaleString()}W total. Surplus: +${Math.round(net).toLocaleString()}W going to battery pack.`;
            } else {
                box.style.borderColor  = '#DC143C';
                box.style.background   = 'rgba(220,20,60,0.05)';
                icon.textContent  = '⚠️';
                title.textContent = 'Not self-sustaining — battery assists';
                title.style.color = '#DC143C';
                desc.textContent  = `At ${psi} PSI / ${rpm} RPM, gen produces ${Math.round(genOutputW).toLocaleString()}W — need ${demand.toLocaleString()}W. Deficit: ${Math.round(Math.abs(net)).toLocaleString()}W. Increase PSI or RPM to hit break-even.`;
            }
        }

        // Update SVG needle (maps psi 20-150 to angle -70° to +60°)
        const needleEl = get('p10-needle');
        if (needleEl) {
            const angle = ((psi - 20) / 130) * 130 - 65;
            const rad = angle * Math.PI / 180;
            const cx = 800, cy = 275, len = 24;
            const x2 = cx + Math.sin(rad) * len;
            const y2 = cy - Math.cos(rad) * len;
            needleEl.setAttribute('x2', x2.toFixed(1));
            needleEl.setAttribute('y2', y2.toFixed(1));
        }
        const gaugeEl = get('p10-psi-gauge');
        if (gaugeEl) gaugeEl.textContent = psi;

        // Battery SOC bar
        const soc = +(get('p10-soc')?.value || 90) / 100;
        const batBar = get('p10-bat-bar');
        if (batBar) batBar.setAttribute('width', Math.round(soc*140));
        setText('p10-bat-pct', Math.round(soc*100)+'%');
    }

    // ── THROTTLE / ACCELERATION ──
    const pedal = get('p10-pedal');
    if (pedal) {
        pedal.addEventListener('input', recalcThrottle);
    }

    function recalcThrottle() {
        const pct = +(get('p10-pedal')?.value || 0);
        const psi = Math.round(20 + (pct / 100) * 130);
        const bore = 80, stroke = 120, pcount = 6;
        const mechEff = 0.5, genEff = 0.8;
        const rpm = Math.round(50 + (pct / 100) * 700);

        const { force, totalTorque, genOutputW } = calcGen(psi, bore, stroke, pcount, rpm, mechEff, genEff);
        const sustained = genOutputW >= 4200;

        setText('p10-pedal-pct', pct+'%');
        setText('p10-acc-psi',     psi);
        setText('p10-acc-force',   Math.round(force).toLocaleString());
        setText('p10-acc-torque',  Math.round(totalTorque).toLocaleString());
        setText('p10-acc-rpm',     rpm);
        setText('p10-acc-watts',   Math.round(genOutputW).toLocaleString());
        setText('p10-acc-sustain', sustained ? '✓ YES' : '✗ NO');

        const sustEl = get('p10-acc-sustain');
        if (sustEl) sustEl.style.color = sustained ? '#00FFD1' : '#DC143C';
        const hiCard = document.querySelector('.p10-acc-highlight');
        if (hiCard) hiCard.style.borderColor = sustained ? '#00FFD1' : '#DC143C';

        // Pressure bar fill (SVG)
        const svgBar = get('p10-throttle-bar-svg');
        if (svgBar) svgBar.setAttribute('width', Math.round((pct/100)*180));
        setText('p10-throttle-psi-svg', psi+' PSI');

        // DOM ramp
        const rampFill = get('p10-ramp-fill');
        const psiPct = ((psi-0)/150)*100;
        if (rampFill) rampFill.style.width = psiPct+'%';
        setText('p10-ramp-psi-lbl', psi+' PSI');

        const genBarFill = get('p10-genbar-fill');
        const genPct = Math.min(100, Math.round((genOutputW/4200)*100));
        if (genBarFill) genBarFill.style.width = genPct+'%';
        setText('p10-genbar-pct', genPct+'%');
    }

    // Init all sliders
    expSliders.forEach(s => {
        const el = get(s.id), out = get(s.out);
        if (el && out) out.textContent = s.fmt(el.value);
    });
    recalcExp();
    recalcThrottle();

})();
</script>

