<script>
    (function() {
        'use strict';

        const get = id => document.getElementById(id);

        const sliders = [
            { id: 'p8-pack', out: 'p8-pack-out', fmt: v => v + ' kWh' },
            { id: 'p8-soc', out: 'p8-soc-out', fmt: v => v + '%' },
            { id: 'p8-heater', out: 'p8-heater-out', fmt: v => (+v).toLocaleString() + ' W' },
            { id: 'p8-speed', out: 'p8-speed-out', fmt: v => v + ' mph' },
            { id: 'p8-solar-roof', out: 'p8-solar-roof-out', fmt: v => (+v).toLocaleString() + ' W' },
            { id: 'p8-solar-front', out: 'p8-solar-front-out', fmt: v => (+v).toLocaleString() + ' W' },
            { id: 'p8-solar-rear', out: 'p8-solar-rear-out', fmt: v => (+v).toLocaleString() + ' W' },
            { id: 'p8-grid-charge', out: 'p8-grid-out', fmt: v => v + ' kW' },
            { id: 'p8-alt-regen-slider', out: 'p8-alt-regen-out', fmt: v => (+v).toLocaleString() + ' W' },
            { id: 'p8-weight', out: 'p8-weight-out', fmt: v => (+v).toLocaleString() + ' lb' },
        ];

        sliders.forEach(s => {
            const el = get(s.id);
            if (!el) return;
            el.addEventListener('input', () => {
                const out = get(s.out);
                if (out) out.textContent = s.fmt(el.value);
                recalc();
            });
        });

        function fmtK(n) {
            return n >= 1000 ? (n / 1000).toFixed(1) + 'k' : Math.round(n).toString();
        }
        function setText(id, v) { const e = get(id); if (e) e.textContent = v; }
        function setW(id, pct) {
            const e = get(id);
            if (e) e.style.width = Math.min(100, Math.max(0, pct)) + '%';
        }

        function recalc() {
            const packKwh = +(get('p8-pack')?.value || 40);
            const soc = +(get('p8-soc')?.value || 88) / 100;
            const heaterW = +(get('p8-heater')?.value || 4200);
            const speedMph = +(get('p8-speed')?.value || 55);
            const solarRoof = +(get('p8-solar-roof')?.value || 2000);
            const solarFront = +(get('p8-solar-front')?.value || 0);
            const solarRear = +(get('p8-solar-rear')?.value || 0);
            const gridKw = +(get('p8-grid-charge')?.value || 7);
            const altRegen = +(get('p8-alt-regen-slider')?.value || 1800);
            const weightLb = +(get('p8-weight')?.value || 1800);

            const totalSolarW = solarRoof + solarFront + solarRear;
            const availableKwh = packKwh * soc;

            // Net draw from battery
            const netDrawW = Math.max(0, heaterW - totalSolarW - altRegen);

            // Range calculation
            const netDrawKw = netDrawW / 1000;
            const rangeHrs = netDrawKw > 0 ? availableKwh / netDrawKw : 999;
            const rangeMiles = Math.min(999, Math.round(rangeHrs * speedMph));

            // Grid charge time to full
            const emptyKwh = packKwh * (1 - soc);
            const chargeHrs = gridKw > 0 ? emptyKwh / gridKw : 999;
            const chargeStr = chargeHrs >= 99 ? 'Full' : chargeHrs.toFixed(1) + ' hrs';

            // Solar daily yield (8hr sun day)
            const solarDayKwh = (totalSolarW * 8) / 1000;

            // Range bar
            const rangePct = Math.min(100, (rangeMiles / 200) * 100);

            // Update metric cards
            setText('p8-mc-pack', availableKwh.toFixed(1) + ' kWh');
            setText('p8-mc-solar', totalSolarW.toLocaleString() + ' W');
            setText('p8-mc-net', netDrawW > 0 ? fmtK(netDrawW) + ' W' : 'Surplus ↑');
            setText('p8-mc-range', rangeMiles >= 999 ? '∞ mi' : rangeMiles + ' mi');
            setText('p8-mc-charge-t', chargeStr);
            setText('p8-mc-solar-day', solarDayKwh.toFixed(1) + ' kWh');

            // Range bar
            setW('p8-range-bar', rangePct);
            setText('p8-range-pct-label', Math.round(rangePct) + '%');

            // Balance bars (normalize to heaterW)
            const norm = v => Math.min(100, Math.round((v / Math.max(1, heaterW)) * 100));
            setW('p8-b-heater', 100);
            setW('p8-b-solar', norm(totalSolarW));
            setW('p8-b-regen', norm(altRegen));
            setW('p8-b-net', norm(netDrawW));

            setText('p8-bv-heater', fmtK(heaterW) + ' W');
            setText('p8-bv-solar', fmtK(totalSolarW) + ' W');
            setText('p8-bv-regen', fmtK(altRegen) + ' W');
            setText('p8-bv-net', netDrawW > 0 ? fmtK(netDrawW) + ' W' : 'Net +');

            // Solar config summary
            setText('p8-sc-roof', solarRoof.toLocaleString() + ' W');
            setText('p8-sc-front', solarFront > 0 ? solarFront.toLocaleString() + ' W' : '0 W (inactive)');
            setText('p8-sc-rear', solarRear > 0 ? solarRear.toLocaleString() + ' W' : '0 W (inactive)');
            setText('p8-sc-total', totalSolarW.toLocaleString() + ' W');

            // SVG panels
            setText('p8-heater-draw', heaterW.toLocaleString() + ' W');
            setText('p8-solar-in', totalSolarW.toLocaleString() + ' W');
            setText('p8-net-draw', netDrawW > 0 ? netDrawW.toLocaleString() + ' W' : 'Net surplus');
            setText('p8-batA-status', availableKwh.toFixed(1) + ' kWh remaining');
            setText('p8-range-remain', rangeMiles >= 999 ? '∞ miles' : rangeMiles + ' miles');
            setText('p8-solar-rate', (totalSolarW / 1000).toFixed(1) + ' kW');
            setText('p8-grid-rate', (gridKw * 1000).toLocaleString() + ' W');
            setText('p8-alt-regen', '~' + fmtK(altRegen) + ' W');
            setText('p8-charge-time', chargeStr);

            const barPx = Math.round((availableKwh / packKwh) * 276);
            const packBar = get('p8-pack-bar');
            if (packBar) packBar.setAttribute('width', barPx);

            const batABarEl = get('p8-batA-bar');
            if (batABarEl) batABarEl.setAttribute('width', Math.round(soc * 164));
            setText('p8-batA-pct', Math.round(soc * 100) + '%');
        }

        // Init labels
        sliders.forEach(s => {
            const el = get(s.id);
            const out = get(s.out);
            if (el && out) out.textContent = s.fmt(el.value);
        });
        recalc();

    })();
</script>

