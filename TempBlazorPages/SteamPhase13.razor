.p13-metric:hover{border-color:#39FF1440;transform:translateY(-2px)}
.p13-metric .val{font-size:2rem;font-weight:800;color:#39FF14;margin-bottom:.3rem}
.p13-metric .lbl{font-size:10px;color:#3a0408;text-transform:uppercase;letter-spacing:.14em}
