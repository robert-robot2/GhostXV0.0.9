<script>
(function(){
'use strict';
const get = id => document.getElementById(id);
const fK = n => Math.abs(n) >= 1000 ? (n/1000).toFixed(1)+'k' : Math.round(n).toString();
const set = (id,v) => {const e=get(id);if(e)e.textContent=v};
const setW = (id,pct) => {const e=get(id);if(e)e.style.width=Math.min(100,Math.max(0,pct))+'%'};

const sliders = [
  {id:'r-psi', out:'r-psi-o', fmt:v=>v+' PSI'},
  {id:'r-bore', out:'r-bore-o', fmt:v=>v+' mm'},
  {id:'r-stroke', out:'r-stroke-o', fmt:v=>v+' mm'},
  {id:'r-rpm', out:'r-rpm-o', fmt:v=>v+' RPM'},
  {id:'r-meff', out:'r-meff-o', fmt:v=>v+'%'},
  {id:'r-geff', out:'r-geff-o', fmt:v=>v+'%'},
  {id:'r-margin', out:'r-margin-o', fmt:v=>v+'%'},
  {id:'r-demand', out:'r-demand-o', fmt:v=>(+v).toLocaleString()+' W'},
  {id:'r-existing', out:'r-existing-o', fmt:v=>(+v).toLocaleString()+' W'},
];

sliders.forEach(s=>{
  const el=get(s.id);
  if(!el)return;
  el.addEventListener('input',()=>{const o=get(s.out);if(o)o.textContent=s.fmt(el.value);recalc()});
});

function recalc(){
  const psi=+(get('r-psi')?.value||120);
  const bore=+(get('r-bore')?.value||80)/1000;
  const stroke=+(get('r-stroke')?.value||120)/1000;
  const rpm=+(get('r-rpm')?.value||350);
  const meff=+(get('r-meff')?.value||55)/100;
  const geff=+(get('r-geff')?.value||80)/100;
  const margin=1-(+(get('r-margin')?.value||20)/100);
  const demand=+(get('r-demand')?.value||2800);
  const existing=+(get('r-existing')?.value||4880);

  const psiPa=psi*6894.76;
  const area=Math.PI*(bore/2)*(bore/2);
  const force=psiPa*area;
  const crankR=stroke/2;
  const torque=force*crankR;
  const omega=(rpm*2*Math.PI)/60;
  const shaftW=torque*omega;
  const genEa=shaftW*meff*geff*margin;
  const genBoth=genEa*2;
  const totalSurplus=existing+genBoth;

  set('r-force',(force/1000).toFixed(1)+' kN');
  set('r-torque',Math.round(torque)+' Nm');
  set('r-shaft',fK(Math.round(shaftW))+' W');
  set('r-gen-ea',fK(Math.round(genEa))+' W');
  set('r-gen-both',fK(Math.round(genBoth))+' W');
  set('r-total-surplus',fK(Math.round(totalSurplus))+' W');

  const rhombPct=Math.min(100,Math.round((genBoth/Math.max(1,totalSurplus))*100));
  setW('r-pct-bar',rhombPct);
  set('r-pct-lbl',rhombPct+'%');

  const norm=v=>Math.min(100,Math.round((v/Math.max(1,demand))*100));
  setW('rb-p12',norm(existing));
  setW('rb-rhomb',norm(genBoth));
  setW('rb-total',norm(totalSurplus));
  set('rv-demand',fK(demand)+' W');
  set('rv-p12',fK(existing)+' W');
  set('rv-rhomb',fK(Math.round(genBoth))+' W');
  set('rv-total',fK(Math.round(totalSurplus))+' W');

  const box=get('r-result-box');
  const title=get('r-result-title');
  const desc=get('r-result-desc');
  if(box&&title&&desc){
    const selfSustain=totalSurplus>=demand;
    box.style.borderLeftColor=selfSustain?'#39FF14':'#FFD700';
    title.style.color=selfSustain?'#39FF14':'#FFD700';
    title.textContent=selfSustain?'✓ SYSTEM SELF-SUSTAINING — rhombic drives add meaningful surplus':'⚠ Check parameters — adjust PSI or RPM';
    desc.textContent='Rhombic drives A+B produce '+fK(Math.round(genBoth))+'W. Phase 12 existing surplus '+fK(existing)+'W. Phase 13 total surplus: '+fK(Math.round(totalSurplus))+'W (after '+get('r-margin').value+'% conservative margin). Heater demand '+fK(demand)+'W.';
  }
}

sliders.forEach(s=>{const el=get(s.id),o=get(s.out);if(el&&o)o.textContent=s.fmt(el.value)});
recalc();
})();
</script>
