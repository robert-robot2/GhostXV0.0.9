@@keyframes p13steam{to{stroke-dashoffset:-24}}
@@keyframes p13pulse{0%,100%{opacity:.4}50%{opacity:1}}
@@keyframes p13power{to{stroke-dashoffset:-18}}
@@keyframes p13rotor{from{transform-origin:center;transform:rotate(0deg)}to{transform-origin:center;transform:rotate(360deg)}}
@@keyframes p13rhombic{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@@keyframes p13rhombic2{0%,100%{transform:translateY(-10px)}50%{transform:translateY(0)}}
@@keyframes p13brake{0%,100%{opacity:.4}50%{opacity:1;fill:#ff4444}}
@@keyframes p13shimmer{0%,100%{opacity:.03}50%{opacity:.10}}
@@keyframes p13glow{0%,100%{opacity:.10}50%{opacity:.30}}
.a-steam{stroke-dasharray:8,4;animation:p13steam 1.8s linear infinite}
.a-pulse{animation:p13pulse 1.3s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:p13power 1.4s linear infinite}
.a-rotor{animation:p13rotor 1.6s linear infinite}
.a-rotor-fast{animation:p13rotor .8s linear infinite}
.a-rhombic{animation:p13rhombic .7s ease-in-out infinite}
.a-rhombic2{animation:p13rhombic2 .7s ease-in-out infinite}
.a-brake{animation:p13brake 1.5s ease-in-out infinite}
.a-shimmer{animation:p13shimmer 3s ease-in-out infinite}
.a-glow{animation:p13glow 2s ease-in-out infinite}
