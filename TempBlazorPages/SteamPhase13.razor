<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 13 · Rhombic Drive + Full Validation Stack</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --indigo:#1a0050;--indigo-dark:#0d0028;--volt:#39FF14;--volt-dim:#00cc00;
  --gold:#FFD700;--gold-dim:#cc9900;--orange:#FF8C00;--teal:#00FFD1;
  --crimson:#DC143C;--blue:#4ab4ff;--bg:#030108;--bg2:#04020a;--bg3:#06040e;
  --text:#dde4f0;--muted:#7a9ab0;
}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
/* ── BANNER ── */
.p13-banner{background:linear-gradient(110deg,#030108 0%,#04020e 45%,#030108 100%);border-bottom:1px solid #39FF1425;padding:3rem 2rem 2rem;text-align:center;position:relative;overflow:hidden}
.p13-banner::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 90% at 25% -5%,#1a005014,transparent),radial-gradient(ellipse 60% 90% at 75% -5%,#FF8C0008,transparent),repeating-linear-gradient(0deg,transparent,transparent 40px,#39FF1403 41px),repeating-linear-gradient(90deg,transparent,transparent 40px,#1a005003 41px)}
.p13-pill{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,#FF8C0012,#39FF1410);border:1px solid #FF8C0045;border-radius:999px;padding:6px 22px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#FF8C00;margin-bottom:1.2rem;position:relative;font-weight:700}
.p13-pill::before{content:'';width:8px;height:8px;border-radius:50%;background:#FF8C00;box-shadow:0 0 12px #FF8C00,0 0 24px #FF8C0060;animation:p13blink 1.2s ease-in-out infinite}
@@keyframes p13blink{0%,100%{opacity:1}50%{opacity:.2}}
.p13-banner h1{font-size:clamp(1.8rem,4.5vw,3rem);font-weight:800;color:#fff;margin:0 0 1rem;letter-spacing:-.025em;position:relative;line-height:1.1}
.p13-banner h1 em{font-style:normal;color:#39FF14;display:block;font-size:.8em;margin-top:.3rem}
.p13-banner p{color:var(--muted);font-size:14px;max-width:950px;line-height:1.85;margin:0 auto;position:relative}
.p13-banner strong{color:#FF8C00}
/* ── SECTION ── */
.p13-section{max-width:1400px;margin:0 auto;padding:4rem 2rem}
.p13-label{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#FF8C00;margin-bottom:.5rem;font-weight:700}
.p13-title{font-size:1.5rem;font-weight:700;color:#fff;margin:0 0 1rem;letter-spacing:-.015em}
.p13-lead{color:var(--muted);font-size:13px;line-height:1.9;max-width:1100px;margin:0 0 2.5rem}
.p13-sep{border:none;border-top:2px solid #04020e;margin:4rem 0}
/* ── METRICS ── */
.p13-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1.2rem;margin:2.5rem 0}
