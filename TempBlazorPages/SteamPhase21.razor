<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 21 · Chevy Miasma Decker 9000 · CVT Hydrostatic Drivetrain</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000008;
  --forge:#06060e;
  --deep:#0a0a14;
  --steam:#39ff14;
  --hydro:#00e5ff;
  --elec:#ffd700;
  --mech:#ff8c00;
  --brake:#ff6ec7;
  --ctrl:#b388ff;
  --therm:#ff6b35;
  --water:#40e0d0;
  --struct:#c0c8d0;
  --safe:#ff4500;
  --text:#e8eef4;
  --muted:#6080a0;
  --worm:#c9a84c;
  --new:#00ffcc;
  --cvt:#1D9E75;
  --shaft:#D85A30;
  --drive:#BA7517;
  --font-d:'Georgia',serif;
  --font-b:'Segoe UI',system-ui,sans-serif;
  --font-m:'Courier New',monospace;
}
body{font-family:var(--font-b);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

.banner{position:relative;background:var(--void);border-bottom:2px solid #0d0d20;padding:5rem 2rem 4rem;text-align:center;overflow:hidden;}
.banner::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 100% 50% at 20% -10%,#39ff1406,transparent),
    radial-gradient(ellipse 80% 50% at 80% -10%,#00ffcc05,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff01 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);}
.phase-pill{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-m);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--new);border:1px solid #00ffcc40;padding:8px 28px;border-radius:2px;margin-bottom:2rem;position:relative;}
.phase-pill::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--new);box-shadow:0 0 20px var(--new);animation:blink 1.2s ease-in-out infinite;}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.05}}
.banner h1{font-family:var(--font-d);font-size:clamp(2rem,5vw,4rem);font-weight:400;color:#fff;letter-spacing:-.03em;line-height:1.05;margin-bottom:1.5rem;}
.banner h1 .s{color:var(--steam)}.banner h1 .w{color:var(--new)}.banner h1 .e{color:var(--elec)}
.banner p{color:var(--muted);font-size:13.5px;max-width:1100px;margin:0 auto;line-height:1.95}
.banner strong{color:var(--new)}
.delta-box{display:inline-block;margin-top:1.5rem;background:var(--forge);border:1px solid #00ffcc30;border-left:3px solid var(--new);padding:.8rem 1.4rem;font-family:var(--font-m);font-size:10px;letter-spacing:.12em;color:var(--new);text-align:left;max-width:900px;width:100%;}
.delta-box span{color:var(--muted);display:block;line-height:1.8}

.tab-nav-wrap{background:var(--forge);border-bottom:2px solid #0d0d20;position:relative;}
.tab-nav{display:flex;gap:0;overflow-x:auto;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#1a1a30 var(--forge);}
.tab-nav::-webkit-scrollbar{height:4px}.tab-nav::-webkit-scrollbar-track{background:var(--forge)}.tab-nav::-webkit-scrollbar-thumb{background:#1a1a30;border-radius:2px}
.scroll-btn{position:absolute;top:0;bottom:0;width:36px;border:none;background:none;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:16px;transition:color .2s;}
.scroll-btn:hover{color:var(--text)}.scroll-btn.left{left:0;background:linear-gradient(90deg,var(--forge) 60%,transparent)}.scroll-btn.right{right:0;background:linear-gradient(270deg,var(--forge) 60%,transparent)}
.tab{flex:0 0 auto;min-width:175px;padding:1.1rem .9rem;text-align:center;cursor:pointer;font-family:var(--font-m);font-size:9px;letter-spacing:.14em;text-transform:uppercase;border-right:1px solid #0d0d20;transition:all .25s;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;}
.tab:hover{background:#0a0a18;color:var(--text)}
.tab.active{background:#040408;}
.tab.t-engine{color:var(--shaft);border-bottom-color:var(--shaft)}
.tab.t-closeup{color:var(--hydro);border-bottom-color:var(--hydro)}
.tab.t-boiler{color:var(--steam);border-bottom-color:var(--steam)}
.tab.t-water{color:var(--water);border-bottom-color:var(--water)}
.tab.t-elec{color:var(--elec);border-bottom-color:var(--elec)}
.tab.t-side{color:var(--mech);border-bottom-color:var(--mech)}
.tab.t-top{color:var(--ctrl);border-bottom-color:var(--ctrl)}
.tab.t-road{color:var(--water);border-bottom-color:var(--water)}
.tab.t-temp{color:var(--therm);border-bottom-color:var(--therm)}
.tab.t-stress{color:var(--safe);border-bottom-color:var(--safe)}
.tab.t-safety{color:var(--brake);border-bottom-color:var(--brake)}
.tab.t-parts{color:var(--struct);border-bottom-color:var(--struct)}

.panel{display:none;animation:fadein .35s ease}.panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.wrap{max-width:1500px;margin:0 auto;padding:3.5rem 2rem}
.eyebrow{font-family:var(--font-m);font-size:10px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:var(--font-d);font-size:1.7rem;font-weight:400;color:#fff;margin-bottom:.7rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:13px;line-height:1.95;max-width:1100px;margin-bottom:2rem}
.sep{border:none;border-top:1px solid #0d0d20;margin:3.5rem 0}

.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#0d0d20;border:1px solid #0d0d20;border-radius:3px;overflow:hidden;margin:2rem 0}
.metric{background:var(--forge);padding:1.4rem .8rem;text-align:center}
.metric .val{font-family:var(--font-d);font-size:1.9rem;line-height:1;margin-bottom:.3rem}
.metric .lbl{font-family:var(--font-m);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.13em}

.schem{background:var(--void);border:1px solid #0d0d20;border-radius:3px;padding:1rem;overflow-x:auto;margin:1.5rem 0}

.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.4rem;margin:1.5rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin:1.5rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.2rem;margin:1.5rem 0}

.card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.6rem}
.card h3{font-family:var(--font-d);font-size:1rem;font-weight:400;color:#fff;margin-bottom:.7rem}
.card p{font-size:12px;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.srow{display:flex;justify-content:space-between;font-size:11.5px;padding:.35rem 0;border-bottom:1px solid #0a0a18;color:var(--muted)}
.srow:last-child{border-bottom:none}.srow .v{font-weight:600}

.badge{display:inline-block;font-family:var(--font-m);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.7rem;border:1px solid}
.new-badge{display:inline-block;font-family:var(--font-m);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:2px 8px;border-radius:2px;border:1px solid var(--new);color:var(--new);margin-left:.5rem}

.tbl{background:var(--void);border:1px solid #0d0d20;border-radius:3px;overflow-x:auto;margin:1.5rem 0}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:600px}
thead{background:var(--forge)}
th{font-family:var(--font-m);font-weight:400;text-align:left;padding:.8rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:9px;border-bottom:2px solid #0d0d20;color:var(--struct)}
td{padding:.65rem 1rem;border-bottom:1px solid #0a0a18;color:var(--text);font-size:12px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}

.legend{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1rem 1.2rem;margin:1rem 0;font-size:10.5px;font-family:var(--font-m)}
.leg-item{display:flex;align-items:center;gap:.5rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.leg-dot{width:20px;height:3px;border-radius:2px}

.warn-box{background:var(--forge);border:1px solid #0d0d20;border-left:4px solid var(--elec);border-radius:3px;padding:1.4rem;margin:1.5rem 0}
.warn-box h4{font-family:var(--font-m);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--elec);margin-bottom:1rem}
.warn-box li{font-size:12px;color:var(--muted);margin-bottom:.5rem;list-style:none;padding-left:1rem;position:relative}
.warn-box li::before{content:'⚠';position:absolute;left:0;color:var(--elec);font-size:10px}

.new-box{background:var(--forge);border:1px solid #0d0d20;border-left:4px solid var(--new);border-radius:3px;padding:1.4rem;margin:1.5rem 0}
.new-box h4{font-family:var(--font-m);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--new);margin-bottom:1rem}
.new-box li{font-size:12px;color:var(--muted);margin-bottom:.5rem;list-style:none;padding-left:1.2rem;position:relative}
.new-box li::before{content:'▶';position:absolute;left:0;color:var(--new);font-size:9px;top:2px}

.pass{color:var(--steam)}.fail{color:var(--safe)}.warn{color:var(--elec)}.na{color:var(--muted)}.isnew{color:var(--new)}

@@keyframes steamflow{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-16}}
@@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes spincw{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes glow{0%,100%{opacity:.1}50%{opacity:.4}}
@@keyframes chainmove{to{stroke-dashoffset:-20}}
@@keyframes waterflow{to{stroke-dashoffset:-16}}
@@keyframes newglow{0%,100%{opacity:.15}50%{opacity:.6}}
@@keyframes drivepulse{to{stroke-dashoffset:-24}}
@@keyframes shaftpulse{0%,100%{opacity:.6}50%{opacity:1}}

.a-steam{stroke-dasharray:8,4;animation:steamflow 1.8s linear infinite}
.a-pulse{animation:pulse 1.4s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-spin{animation:spin 1s linear infinite}
.a-spincw{animation:spincw 1s linear infinite}
.a-glow{animation:glow 2s ease-in-out infinite}
.a-chain{stroke-dasharray:6,3;animation:chainmove 1s linear infinite}
.a-water{stroke-dasharray:5,4;animation:waterflow 1s linear infinite}
.a-newglow{animation:newglow 2s ease-in-out infinite}
.a-drive{stroke-dasharray:10,4;animation:drivepulse 1.2s linear infinite}
.a-shaft{animation:shaftpulse 1s ease-in-out infinite}

.footer{background:var(--forge);border-top:1px solid #0d0d20;padding:1.5rem;text-align:center;font-family:var(--font-m);font-size:10px;color:#1a1a30;letter-spacing:.1em}
@@media(max-width:700px){.wrap{padding:2rem 1rem}.tab{min-width:140px;padding:.7rem .5rem}}
</style>
</head>
<body>

<div class="banner">
  <div class="phase-pill">Phase 21 · CVT Hydrostatic Drivetrain · Chevy Miasma Decker 9000</div>
  <h1><span class="s">Chevy</span> <span class="w">Miasma</span> <span class="e">Decker 9000</span></h1>
  <p>
    Phase 21 engine redesign. <strong>Locked differentials on cylinder shafts → single amber driveshaft through all three → CVT hydrostatic transmission → rear 2WD.</strong>
    Worm spine removed from drive path. 17.5:1 chain to dual 2,500W alternators retained on front worm exit.
    Flash boiler 1 gal + 20 gal water tank + EWI + condenser loop carried forward from Phase 20.
    75mm bore · 250mm stroke pistons. 3 cylinder shafts · locomotive rails · locked diffs per shaft.
    Rear 2WD via CVT hydrostatic (CRV-style variable ratio). LiFePO4 48V/100Ah cold start. Standard hydraulic brakes.
  </p>
  <div class="delta-box">
    PHASE 21 CHANGES FROM PHASE 20
    <span>▶ Worm spine removed from drive path — replaced by locked differential coupling on each cylinder shaft</span>
    <span>▶ Single amber driveshaft passes through all 3 locked diffs — each diff couples its cylinder shaft rotation to the driveshaft</span>
    <span>▶ CVT hydrostatic transmission (CRV-style) replaces 4-speed manual + worm spine gearbox — smooth variable ratio output</span>
    <span>▶ Drive configuration changed: rear 2WD via CVT output (Phase 20 was 4WD locked diff via worm → gearbox → transfer)</span>
    <span>▶ 17.5:1 chain to dual alternators RETAINED — front exit from cylinder shaft 1 via helical gear + chain (unchanged)</span>
    <span>▶ Flash boiler · EWI · 20 gal tank · condenser · static oil bath · 24V electrical all carried forward from Phase 20</span>
    <span>▶ Locomotive rail system unchanged: piston A → left rail WL1/WL2/WL3 · piston B → right rail WR1/WR2/WR3</span>
    <span>▶ Cylinder shafts unchanged: 60mm ∅ · 4340 steel · 250mm locomotive wheels per shaft</span>
  </div>
</div>

<div class="tab-nav-wrap">
  <button class="scroll-btn left" onclick="scrollTabs(-200)">&#8592;</button>
  <div class="tab-nav" id="tabNav">
    <div class="tab t-engine active" onclick="showTab('engine',this)">⚙️ Engine<br><small style="font-size:7px">3 Shafts · Locked Diffs · CVT</small></div>
    <div class="tab t-closeup" onclick="showTab('closeup',this)">🔬 Drive Close-Up<br><small style="font-size:7px">Driveshaft · Diffs · CVT Path</small></div>
    <div class="tab t-boiler" onclick="showTab('boiler',this)">🔥 Flash Boiler<br><small style="font-size:7px">1 Gal Flash · EWI · Tank</small></div>
    <div class="tab t-water" onclick="showTab('water',this)">💧 Water System<br><small style="font-size:7px">20 Gal Tank · Condenser</small></div>
    <div class="tab t-elec" onclick="showTab('elec',this)">⚡ Electrical<br><small style="font-size:7px">24V · Dual Alt · LiFePO4</small></div>
    <div class="tab t-side" onclick="showTab('side',this)">↔ Side View<br><small style="font-size:7px">Full Vehicle Profile</small></div>
    <div class="tab t-top" onclick="showTab('top',this)">⬆ Top View<br><small style="font-size:7px">Rear 2WD · CVT · Driveshaft</small></div>
    <div class="tab t-road" onclick="showTab('road',this)">🛣 Road Tests<br><small style="font-size:7px">Speed · Range · Torque</small></div>
    <div class="tab t-temp" onclick="showTab('temp',this)">🌡 Temperature<br><small style="font-size:7px">Thermal Analysis</small></div>
    <div class="tab t-stress" onclick="showTab('stress',this)">💪 Stress Tests<br><small style="font-size:7px">Material · Wear · Fatigue</small></div>
    <div class="tab t-safety" onclick="showTab('safety',this)">🛡 Safety<br><small style="font-size:7px">Pressure · Brakes · Fail-Safe</small></div>
    <div class="tab t-parts" onclick="showTab('parts',this)">📋 Parts List<br><small style="font-size:7px">Full Build · Cost · Weight</small></div>
  </div>
  <button class="scroll-btn right" onclick="scrollTabs(200)">&#8594;</button>
</div>

<!-- ENGINE FRONT -->
<div class="panel active" id="panel-engine">
<div class="wrap">
  <div class="eyebrow" style="color:var(--shaft)">Diagram 1 · Engine — Phase 21</div>
  <h2 class="section-title">3 Cylinder Shafts · Locked Diffs · Amber Driveshaft → CVT Hydrostatic → Rear 2WD</h2>
  <p class="section-lead">
    Three cylinder shafts (60mm ∅, 4340 steel) run perpendicular across the engine bay. Each shaft carries 250mm ∅ locomotive wheels on its rail engagement points.
    Piston A (75mm bore, 250mm stroke) drives left locomotive rail → engages WL1, WL2, WL3. Piston B drives right rail → WR1, WR2, WR3. 180° phase offset.
    Each cylinder shaft has a locked differential at its midpoint. A single amber driveshaft passes through all three locked diffs — each diff couples its shaft's rotation into the driveshaft.
    Driveshaft exits rear → CVT hydrostatic transmission (CRV-style variable ratio) → rear 2WD axle.
    Front alternator chain: cylinder shaft 1 front exit → 17.5:1 chain/belt → dual 2,500W alternators at 3,500 RPM. Static oil bath — sealed engine box, all internals oil-submerged.
  </p>

  <div class="metrics">
    <div class="metric"><div class="val" style="color:var(--steam)">2</div><div class="lbl">Steam Pistons</div></div>
    <div class="metric"><div class="val" style="color:var(--shaft)">3</div><div class="lbl">Cylinder Shafts</div></div>
    <div class="metric"><div class="val" style="color:var(--hydro)">75mm</div><div class="lbl">Piston Bore</div></div>
    <div class="metric"><div class="val" style="color:var(--steam)">250mm</div><div class="lbl">Piston Stroke</div></div>
    <div class="metric"><div class="val" style="color:var(--shaft)">3</div><div class="lbl">Locked Diffs</div></div>
    <div class="metric"><div class="val" style="color:var(--drive)">1</div><div class="lbl">Amber Driveshaft</div></div>
    <div class="metric"><div class="val" style="color:var(--cvt)">CVT</div><div class="lbl">Hydrostatic Trans</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">17.5:1</div><div class="lbl">Alt Chain Ratio</div></div>
    <div class="metric"><div class="val" style="color:var(--worm)">90</div><div class="lbl">PSI Operating</div></div>
    <div class="metric"><div class="val" style="color:var(--water)">200</div><div class="lbl">RPM Engine</div></div>
  </div>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines (19mm ID)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--mech)"></div>Locomotive rails</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--ctrl)"></div>Locomotive wheels (250mm)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--shaft)"></div>Cylinder shafts + locked diffs</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--drive)"></div>Amber driveshaft (through all 3 diffs)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--cvt)"></div>CVT hydrostatic → rear 2WD</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>17.5:1 chain → dual alt</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>Static oil bath PAO ISO-68</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--new)"></div>New in Phase 21</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 900" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="eg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#D85A30" stop-opacity=".1"/><stop offset="100%" stop-color="#D85A30" stop-opacity="0"/></radialGradient>
    <radialGradient id="dg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#BA7517" stop-opacity=".15"/><stop offset="100%" stop-color="#BA7517" stop-opacity="0"/></radialGradient>
    <radialGradient id="cvtg" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#1D9E75" stop-opacity=".15"/><stop offset="100%" stop-color="#1D9E75" stop-opacity="0"/></radialGradient>
    <filter id="gf"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="as" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="ae" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
    <marker id="ad" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#BA7517"/></marker>
    <marker id="ac" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#1D9E75"/></marker>
  </defs>
  <rect width="1400" height="900" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="12" fill="#D85A30" font-family="Courier New" font-weight="700" letter-spacing="2">ENGINE — PHASE 21 — TOP DOWN — LOCKED DIFFS · AMBER DRIVESHAFT · CVT HYDROSTATIC</text>
  <text x="700" y="38" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">75mm bore · 250mm stroke · 60mm shaft ∅ · 90 PSI · 200 RPM · Rear 2WD via CVT</text>

  <!-- Engine bay outer -->
  <rect x="60" y="55" width="1280" height="800" rx="14" fill="#04040c" stroke="#0d0d20" stroke-width="1.5"/>
  <text x="700" y="75" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← FRONT · 17.5:1 CHAIN ALT EXIT ←</text>
  <text x="700" y="840" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← REAR · AMBER DRIVESHAFT EXIT → CVT HYDROSTATIC → REAR 2WD →</text>

  <!-- Engine box sealed -->
  <rect x="180" y="95" width="1040" height="660" rx="16" fill="#010a02" stroke="#39ff14" stroke-width="2" filter="url(#gf)"/>
  <ellipse cx="700" cy="425" rx="360" ry="200" fill="url(#eg1)" class="a-glow"/>
  <text x="700" y="115" text-anchor="middle" font-size="10" fill="#39ff14" font-family="Courier New" font-weight="700">SEALED STATIC OIL BATH ENGINE BOX — EN-GJL-250 GREY IRON — PAO ISO-68 — ALL INTERNALS SUBMERGED</text>

  <!-- AMBER DRIVESHAFT — horizontal through all 3 diffs -->
  <rect x="180" y="410" width="1040" height="30" rx="6" fill="#1a0800" stroke="#BA7517" stroke-width="4" filter="url(#gf)"/>
  <ellipse cx="700" cy="425" rx="480" ry="18" fill="url(#dg1)" class="a-newglow"/>
