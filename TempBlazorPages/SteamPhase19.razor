<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 19 · Chevy Miasma Decker 9000 · Prototype Review</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000008;
  --forge:#06060e;
  --deep:#0a0a14;
  --steam:#39ff14;
  --hydro:#00e5ff;
  --elec:#ffd700;
  --mech:#ff8c00;
  --brake:#ff6ec7;
  --ctrl:#b388ff;
  --therm:#ff6b35;
  --water:#40e0d0;
  --struct:#c0c8d0;
  --safe:#ff4500;
  --text:#e8eef4;
  --muted:#6080a0;
  --worm:#c9a84c;
  --font-d:'Georgia',serif;
  --font-b:'Segoe UI',system-ui,sans-serif;
  --font-m:'Courier New',monospace;
}
body{font-family:var(--font-b);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

.banner{position:relative;background:var(--void);border-bottom:2px solid #0d0d20;padding:5rem 2rem 4rem;text-align:center;overflow:hidden;}
.banner::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 100% 50% at 20% -10%,#39ff1406,transparent),
    radial-gradient(ellipse 80% 50% at 80% -10%,#c9a84c05,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff01 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);}
.phase-pill{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-m);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--worm);border:1px solid #c9a84c40;padding:8px 28px;border-radius:2px;margin-bottom:2rem;position:relative;}
.phase-pill::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--worm);box-shadow:0 0 20px var(--worm);animation:blink 1.2s ease-in-out infinite;}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.05}}
.banner h1{font-family:var(--font-d);font-size:clamp(2rem,5vw,4rem);font-weight:400;color:#fff;letter-spacing:-.03em;line-height:1.05;margin-bottom:1.5rem;}
.banner h1 .s{color:var(--steam)}.banner h1 .w{color:var(--worm)}.banner h1 .e{color:var(--elec)}
.banner p{color:var(--muted);font-size:13.5px;max-width:980px;margin:0 auto;line-height:1.95}
.banner strong{color:var(--worm)}

.tab-nav-wrap{background:var(--forge);border-bottom:2px solid #0d0d20;position:relative;}
.tab-nav{display:flex;gap:0;overflow-x:auto;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#1a1a30 var(--forge);}
.tab-nav::-webkit-scrollbar{height:4px}.tab-nav::-webkit-scrollbar-track{background:var(--forge)}.tab-nav::-webkit-scrollbar-thumb{background:#1a1a30;border-radius:2px}
.scroll-btn{position:absolute;top:0;bottom:0;width:36px;border:none;background:none;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:16px;transition:color .2s;}
.scroll-btn:hover{color:var(--text)}.scroll-btn.left{left:0;background:linear-gradient(90deg,var(--forge) 60%,transparent)}.scroll-btn.right{right:0;background:linear-gradient(270deg,var(--forge) 60%,transparent)}
.tab{flex:0 0 auto;min-width:180px;padding:1.1rem .9rem;text-align:center;cursor:pointer;font-family:var(--font-m);font-size:9px;letter-spacing:.14em;text-transform:uppercase;border-right:1px solid #0d0d20;transition:all .25s;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;}
.tab:hover{background:#0a0a18;color:var(--text)}
.tab.active{background:#040408;}
.tab.t-engine{color:var(--worm);border-bottom-color:var(--worm)}
.tab.t-closeup{color:var(--hydro);border-bottom-color:var(--hydro)}
.tab.t-boiler{color:var(--steam);border-bottom-color:var(--steam)}
.tab.t-side{color:var(--mech);border-bottom-color:var(--mech)}
.tab.t-top{color:var(--ctrl);border-bottom-color:var(--ctrl)}
.tab.t-electrical{color:var(--elec);border-bottom-color:var(--elec)}
.tab.t-road{color:var(--water);border-bottom-color:var(--water)}
.tab.t-temp{color:var(--therm);border-bottom-color:var(--therm)}
.tab.t-stress{color:var(--safe);border-bottom-color:var(--safe)}
.tab.t-safety{color:var(--brake);border-bottom-color:var(--brake)}
.tab.t-parts{color:var(--struct);border-bottom-color:var(--struct)}

.panel{display:none;animation:fadein .35s ease}.panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

.wrap{max-width:1500px;margin:0 auto;padding:3.5rem 2rem}
.sep{border:none;border-top:1px solid #0d0d20;margin:3.5rem 0}
.eyebrow{font-family:var(--font-m);font-size:10px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:var(--font-d);font-size:1.7rem;font-weight:400;color:#fff;margin-bottom:.7rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:13px;line-height:1.95;max-width:1100px;margin-bottom:2rem}

.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#0d0d20;border:1px solid #0d0d20;border-radius:3px;overflow:hidden;margin:2rem 0}
.metric{background:var(--forge);padding:1.4rem .8rem;text-align:center}
.metric .val{font-family:var(--font-d);font-size:1.9rem;line-height:1;margin-bottom:.3rem}
.metric .lbl{font-family:var(--font-m);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.13em}

.schem{background:var(--void);border:1px solid #0d0d20;border-radius:3px;padding:1rem;overflow-x:auto;margin:1.5rem 0}

.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.4rem;margin:1.5rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin:1.5rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin:1.5rem 0}

.card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.6rem}
.card h3{font-family:var(--font-d);font-size:1rem;font-weight:400;color:#fff;margin-bottom:.7rem}
.card p{font-size:12px;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.srow{display:flex;justify-content:space-between;font-size:11.5px;padding:.35rem 0;border-bottom:1px solid #0a0a18;color:var(--muted)}
.srow:last-child{border-bottom:none}.srow .v{font-weight:600}

.badge{display:inline-block;font-family:var(--font-m);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.7rem;border:1px solid}

.tbl{background:var(--void);border:1px solid #0d0d20;border-radius:3px;overflow-x:auto;margin:1.5rem 0}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:600px}
thead{background:var(--forge)}
th{font-family:var(--font-m);font-weight:400;text-align:left;padding:.8rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:9px;border-bottom:2px solid #0d0d20;color:var(--struct)}
td{padding:.65rem 1rem;border-bottom:1px solid #0a0a18;color:var(--text);font-size:12px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}

.legend{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1rem 1.2rem;margin:1rem 0;font-size:10.5px;font-family:var(--font-m)}
.leg-item{display:flex;align-items:center;gap:.5rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.leg-dot{width:20px;height:3px;border-radius:2px}

.warn-box{background:var(--forge);border:1px solid #0d0d20;border-left:4px solid var(--elec);border-radius:3px;padding:1.4rem;margin:1.5rem 0}
.warn-box h4{font-family:var(--font-m);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--elec);margin-bottom:1rem}
.warn-box li{font-size:12px;color:var(--muted);margin-bottom:.5rem;list-style:none;padding-left:1rem;position:relative}
.warn-box li::before{content:'⚠';position:absolute;left:0;color:var(--elec);font-size:10px}

.pass{color:var(--steam)}.fail{color:var(--safe)}.warn{color:var(--elec)}.na{color:var(--muted)}

@@keyframes steamflow{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-16}}
@@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes spincw{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes glow{0%,100%{opacity:.1}50%{opacity:.4}}
@@keyframes wormrotate{from{stroke-dashoffset:0}to{stroke-dashoffset:-40}}
@@keyframes chainmove{to{stroke-dashoffset:-20}}

.a-steam{stroke-dasharray:8,4;animation:steamflow 1.8s linear infinite}
.a-pulse{animation:pulse 1.4s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-spin{animation:spin 1s linear infinite}
.a-spincw{animation:spincw 1s linear infinite}
.a-glow{animation:glow 2s ease-in-out infinite}
.a-chain{stroke-dasharray:6,3;animation:chainmove 1s linear infinite}
.a-worm{stroke-dasharray:10,5;animation:wormrotate 1.2s linear infinite}

.footer{background:var(--forge);border-top:1px solid #0d0d20;padding:1.5rem;text-align:center;font-family:var(--font-m);font-size:10px;color:#1a1a30;letter-spacing:.1em}
@@media(max-width:700px){.wrap{padding:2rem 1rem}.tab{min-width:140px;padding:.7rem .5rem}}
</style>
</head>
<body>

<div class="banner">
  <div class="phase-pill">Phase 19 · Close-to-Final Prototype Review · Chevy Miasma Decker 9000</div>
  <h1><span class="s">Chevy</span> <span class="w">Miasma</span> <span class="e">Decker 9000</span></h1>
  <p>
    Phase 19 near-final prototype review. <strong>Corrected engine: 3 cylinder shafts total, perpendicular to worm spine.</strong>
    Two steam pistons drive two locomotive rails (one per side). Each rail drives all 3 cylinder shaft wheel sets on that side.
    Three helical gears at shaft midpoints mesh into 3 worm sections on the central spine.
    Worm spine front → chain multiplier → generator/alternator. Worm spine rear → 4-speed manual gearbox with reverse → 4WD transfer → wheels.
    Standard hydraulic brake fluid system. LiFePO4 battery. Chevy Impala chassis. All systems reviewed below.
  </p>
</div>

<div class="tab-nav-wrap">
  <button class="scroll-btn left" onclick="scrollTabs(-200)">&#8592;</button>
  <div class="tab-nav" id="tabNav">
    <div class="tab t-engine active" onclick="showTab('engine',this)">⚙️ Engine Front<br><small style="font-size:7px">3 Cylinders · Rails · Worm</small></div>
    <div class="tab t-closeup" onclick="showTab('closeup',this)">🔬 Engine Close-Up<br><small style="font-size:7px">Worm Spine · Gear Detail</small></div>
    <div class="tab t-boiler" onclick="showTab('boiler',this)">🔥 Rear Boiler<br><small style="font-size:7px">Two Steam Pipes · Boiler</small></div>
    <div class="tab t-side" onclick="showTab('side',this)">↔ Side View<br><small style="font-size:7px">Full Vehicle Profile</small></div>
    <div class="tab t-top" onclick="showTab('top',this)">⬆ Top View<br><small style="font-size:7px">Full Vehicle Plan</small></div>
    <div class="tab t-electrical" onclick="showTab('electrical',this)">⚡ Electrical<br><small style="font-size:7px">Battery · Generator · Recharge</small></div>
    <div class="tab t-road" onclick="showTab('road',this)">🛣 Road Tests<br><small style="font-size:7px">Speed · Range · Torque</small></div>
    <div class="tab t-temp" onclick="showTab('temp',this)">🌡 Temperature<br><small style="font-size:7px">Thermal Analysis</small></div>
    <div class="tab t-stress" onclick="showTab('stress',this)">💪 Stress Tests<br><small style="font-size:7px">Material · Wear · Fatigue</small></div>
    <div class="tab t-safety" onclick="showTab('safety',this)">🛡 Safety<br><small style="font-size:7px">Pressure · Brakes · Fail-Safe</small></div>
    <div class="tab t-parts" onclick="showTab('parts',this)">📋 Parts List<br><small style="font-size:7px">Full Build Components</small></div>
  </div>
  <button class="scroll-btn right" onclick="scrollTabs(200)">&#8594;</button>
</div>

<!-- ENGINE FRONT -->
<div class="panel active" id="panel-engine">
<div class="wrap">
  <div class="eyebrow" style="color:var(--worm)">Diagram 1 · Front Engine Compartment — Phase 19 Corrected</div>
  <h2 class="section-title">3 Cylinder Shafts · Locomotive Rails · Worm Spine · Chain to Generator</h2>
  <p class="section-lead">
    CORRECTED from Phase 18. Three cylinder shafts only, running perpendicular (left to right) across the engine.
    Piston A drives left locomotive rail. Piston B drives right locomotive rail. Each rail engages all 3 cylinder shaft wheel sets on its side simultaneously.
    Each cylinder shaft has a precision helical gear at its midpoint. Three helical gears mesh into 3 dedicated worm sections on the central spine.
    Worm spine runs front to back. Front exit drives enclosed oil bath chain multiplier to generator and alternator.
    Rear exit drives 4-speed manual gearbox with reverse, then 4WD transfer case to all four wheels.
  </p>

  <div class="metrics">
    <div class="metric"><div class="val" style="color:var(--steam)">2</div><div class="lbl">Steam Pistons</div></div>
    <div class="metric"><div class="val" style="color:var(--mech)">3</div><div class="lbl">Cylinder Shafts</div></div>
    <div class="metric"><div class="val" style="color:var(--worm)">3</div><div class="lbl">Worm Sections</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">80mm</div><div class="lbl">Piston Bore</div></div>
    <div class="metric"><div class="val" style="color:var(--steam)">120mm</div><div class="lbl">Piston Stroke</div></div>
    <div class="metric"><div class="val" style="color:var(--mech)">150 PSI</div><div class="lbl">Max Steam</div></div>
    <div class="metric"><div class="val" style="color:var(--worm)">~1,800</div><div class="lbl">Nm Est. Torque</div></div>
    <div class="metric"><div class="val" style="color:var(--hydro)">200–400</div><div class="lbl">RPM Operating</div></div>
  </div>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--mech)"></div>Locomotive rails</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--worm)"></div>Worm spine driveshaft</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>Generator chain</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--hydro)"></div>Cylinder shafts</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--ctrl)"></div>Helical gears</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>Oil bath</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 820" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="eg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#c9a84c" stop-opacity=".12"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/></radialGradient>
    <filter id="gf"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="as" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="aw" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#c9a84c"/></marker>
    <marker id="ae" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
  </defs>
  <rect width="1400" height="820" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="12" fill="#c9a84c" font-family="Courier New" font-weight="700" letter-spacing="2">ENGINE FRONT COMPARTMENT — PHASE 19 — TOP DOWN VIEW — 3 CYLINDER SHAFTS CORRECTED</text>
  <text x="700" y="38" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">Chevy Impala Bay 1,219mm × 914mm · 3 shafts total · 2 rails · 1 worm spine</text>

  <!-- Engine bay -->
  <rect x="60" y="55" width="1280" height="720" rx="14" fill="#04040c" stroke="#0d0d20" stroke-width="1.5"/>
  <text x="700" y="75" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← FRONT · RADIATOR SIDE →</text>
  <text x="700" y="765" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← REAR · FIREWALL · 4-SPEED GEARBOX → 4WD →</text>

  <!-- Engine box -->
  <rect x="180" y="100" width="1040" height="620" rx="16" fill="#010a02" stroke="#39ff14" stroke-width="2" filter="url(#gf)"/>
  <ellipse cx="700" cy="410" rx="360" ry="180" fill="url(#eg1)" class="a-glow"/>
  <text x="700" y="122" text-anchor="middle" font-size="10" fill="#39ff14" font-family="Courier New" font-weight="700">SEALED OIL BATH ENGINE BOX — EN-GJL-250 GREY IRON — PAO ISO-68</text>

  <!-- WORM SPINE — center, front to back -->
  <rect x="660" y="90" width="80" height="650" rx="8" fill="#1a0e00" stroke="#c9a84c" stroke-width="3" filter="url(#gf)"/>
  <text x="700" y="175" text-anchor="middle" font-size="9" fill="#c9a84c" font-family="Courier New" font-weight="700">HIGH-LEAD</text>
  <text x="700" y="188" text-anchor="middle" font-size="9" fill="#c9a84c" font-family="Courier New" font-weight="700">WORM SPINE</text>
  <text x="700" y="201" text-anchor="middle" font-size="8" fill="#604000" font-family="Courier New">∅60mm · 4140 steel</text>

  <!-- Worm sections -->
  <rect x="655" y="240" width="90" height="55" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="658" y1="250" x2="742" y2="250" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm"/>
  <line x1="658" y1="262" x2="742" y2="262" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.2s"/>
  <line x1="658" y1="274" x2="742" y2="274" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.4s"/>
  <text x="700" y="308" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 1</text>

  <rect x="655" y="397" width="90" height="55" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="658" y1="407" x2="742" y2="407" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.15s"/>
  <line x1="658" y1="419" x2="742" y2="419" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.35s"/>
  <line x1="658" y1="431" x2="742" y2="431" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.55s"/>
  <text x="700" y="465" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 2</text>

  <rect x="655" y="555" width="90" height="55" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="658" y1="565" x2="742" y2="565" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.3s"/>
  <line x1="658" y1="577" x2="742" y2="577" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.5s"/>
  <line x1="658" y1="589" x2="742" y2="589" stroke="#c9a84c" stroke-width="2" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.7s"/>
  <text x="700" y="622" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 3</text>

  <!-- Worm front exit -->
  <rect x="668" y="50" width="64" height="44" rx="4" fill="#1a0e00" stroke="#c9a84c" stroke-width="2"/>
  <text x="700" y="70" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">→ CHAIN</text>
  <text x="700" y="83" text-anchor="middle" font-size="7" fill="#604000" font-family="Courier New">→ GEN</text>
  <line x1="700" y1="50" x2="700" y2="42" stroke="#c9a84c" stroke-width="2.5" marker-end="url(#aw)" class="a-worm"/>

  <!-- Worm rear exit -->
  <rect x="668" y="740" width="64" height="44" rx="4" fill="#1a0e00" stroke="#c9a84c" stroke-width="2"/>
  <text x="700" y="758" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">→ GBOX</text>
  <text x="700" y="771" text-anchor="middle" font-size="7" fill="#604000" font-family="Courier New">4-SPEED</text>
  <line x1="700" y1="784" x2="700" y2="796" stroke="#c9a84c" stroke-width="2.5" marker-end="url(#aw)" class="a-worm"/>

  <!-- CYLINDER SHAFT 1 — top — full width left to right -->
  <rect x="195" y="257" width="465" height="26" rx="5" fill="#020c18" stroke="#00e5ff" stroke-width="2"/>
  <text x="428" y="275" text-anchor="middle" font-size="8" fill="#00e5ff" font-family="Courier New">CYLINDER SHAFT 1 — ∅45mm · 4340 steel</text>
  <!-- Right side shaft 1 -->
  <rect x="745" y="257" width="450" height="26" rx="5" fill="#020c18" stroke="#00e5ff" stroke-width="2"/>
