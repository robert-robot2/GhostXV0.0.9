<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 17 · Chevy Miasma Decker 9000</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000008;
  --forge:#06060e;
  --deep:#0a0a14;
  --steam:#39ff14;
  --hydro:#00e5ff;
  --elec:#ffd700;
  --mech:#ff8c00;
  --brake:#ff6ec7;
  --ctrl:#b388ff;
  --therm:#ff6b35;
  --water:#40e0d0;
  --struct:#c0c8d0;
  --safe:#ff4500;
  --text:#e8eef4;
  --muted:#6080a0;
  --font-d:'Georgia',serif;
  --font-b:'Segoe UI',system-ui,sans-serif;
  --font-m:'Courier New',monospace;
}
body{font-family:var(--font-b);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

/* BANNER */
.banner{
  position:relative;background:var(--void);
  border-bottom:2px solid #0d0d20;
  padding:5rem 2rem 4rem;text-align:center;overflow:hidden;
}
.banner::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 100% 50% at 20% -10%,#39ff1406,transparent),
    radial-gradient(ellipse 80% 50% at 80% -10%,#00e5ff05,transparent),
    radial-gradient(ellipse 60% 40% at 50% 110%,#ffd70004,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff01 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);
}
.phase-pill{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-m);font-size:11px;letter-spacing:.28em;
  text-transform:uppercase;color:var(--steam);
  border:1px solid #39ff1440;padding:8px 28px;border-radius:2px;
  margin-bottom:2rem;position:relative;
}
.phase-pill::before{
  content:'';width:8px;height:8px;border-radius:50%;
  background:var(--steam);box-shadow:0 0 20px var(--steam);
  animation:blink 1.2s ease-in-out infinite;
}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.05}}
.banner h1{
  font-family:var(--font-d);
  font-size:clamp(2.2rem,5vw,4.2rem);
  font-weight:400;color:#fff;letter-spacing:-.03em;
  line-height:1.05;margin-bottom:1.5rem;position:relative;
}
.banner h1 .s{color:var(--steam)}
.banner h1 .h{color:var(--hydro)}
.banner h1 .e{color:var(--elec)}
.banner p{color:var(--muted);font-size:13.5px;max-width:980px;margin:0 auto;line-height:1.95}
.banner strong{color:var(--elec)}

/* NAV TABS — SCROLLABLE */
.tab-nav-wrap{background:var(--forge);border-bottom:2px solid #0d0d20;position:relative;}
.tab-nav{
  display:flex;gap:0;overflow-x:auto;scroll-behavior:smooth;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:thin;scrollbar-color:#1a1a30 var(--forge);
}
.tab-nav::-webkit-scrollbar{height:4px}
.tab-nav::-webkit-scrollbar-track{background:var(--forge)}
.tab-nav::-webkit-scrollbar-thumb{background:#1a1a30;border-radius:2px}
.scroll-btn{
  position:absolute;top:0;bottom:0;width:36px;
  background:linear-gradient(90deg,var(--forge),transparent);
  border:none;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;
  color:var(--muted);font-size:16px;transition:color .2s;
}
.scroll-btn:hover{color:var(--text)}
.scroll-btn.left{left:0;background:linear-gradient(90deg,var(--forge) 60%,transparent)}
.scroll-btn.right{right:0;background:linear-gradient(270deg,var(--forge) 60%,transparent)}
.tab{
  flex:0 0 auto;min-width:160px;padding:1.1rem .9rem;text-align:center;cursor:pointer;
  font-family:var(--font-m);font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  border-right:1px solid #0d0d20;transition:all .25s;color:var(--muted);
  border-bottom:3px solid transparent;white-space:nowrap;
}
.tab:hover{background:#0a0a18;color:var(--text)}
.tab.a-front{color:var(--hydro);border-bottom-color:var(--hydro);background:#00050a}
.tab.a-rear{color:var(--steam);border-bottom-color:var(--steam);background:#010800}
.tab.a-chassis{color:var(--elec);border-bottom-color:var(--elec);background:#080600}
.tab.a-engine{color:var(--mech);border-bottom-color:var(--mech);background:#080400}
.tab.a-electrical{color:var(--ctrl);border-bottom-color:var(--ctrl);background:#060010}
.tab.a-pressure{color:var(--mech);border-bottom-color:var(--mech);background:#080400}
.tab.a-thermal{color:var(--brake);border-bottom-color:var(--brake);background:#080408}
.tab.a-water{color:var(--water);border-bottom-color:var(--water);background:#020808}

/* PANELS */
.panel{display:none;animation:fadein .35s ease}
.panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* WRAP */
.wrap{max-width:1500px;margin:0 auto;padding:3.5rem 2rem}
.sep{border:none;border-top:1px solid #0d0d20;margin:3.5rem 0}

/* EYEBROW + TITLE */
.eyebrow{font-family:var(--font-m);font-size:10px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:var(--font-d);font-size:1.7rem;font-weight:400;color:#fff;margin-bottom:.7rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:13px;line-height:1.95;max-width:1100px;margin-bottom:2rem}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#0d0d20;border:1px solid #0d0d20;border-radius:3px;overflow:hidden;margin:2rem 0}
.metric{background:var(--forge);padding:1.4rem .8rem;text-align:center}
.metric .val{font-family:var(--font-d);font-size:1.9rem;line-height:1;margin-bottom:.3rem}
.metric .lbl{font-family:var(--font-m);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.13em}

/* SCHEMATIC */
.schem{background:var(--void);border:1px solid #0d0d20;border-radius:3px;padding:1rem;overflow-x:auto;margin:1.5rem 0}

/* GRIDS */
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.4rem;margin:1.5rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin:1.5rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin:1.5rem 0}

/* CARDS */
.card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.6rem}
.card h3{font-family:var(--font-d);font-size:1rem;font-weight:400;color:#fff;margin-bottom:.7rem}
.card p{font-size:12px;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.srow{display:flex;justify-content:space-between;font-size:11.5px;padding:.35rem 0;border-bottom:1px solid #0a0a18;color:var(--muted)}
.srow:last-child{border-bottom:none}
.srow .v{font-weight:600}

/* BADGE */
.badge{display:inline-block;font-family:var(--font-m);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.7rem;border:1px solid}

/* TABLE */
.tbl{background:var(--void);border:1px solid #0d0d20;border-radius:3px;overflow-x:auto;margin:1.5rem 0}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:600px}
thead{background:var(--forge)}
th{font-family:var(--font-m);font-weight:400;text-align:left;padding:.8rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:9px;border-bottom:2px solid #0d0d20;color:var(--struct)}
td{padding:.65rem 1rem;border-bottom:1px solid #0a0a18;color:var(--text);font-size:12px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}

/* CALLOUT */
.callout{display:flex;gap:1rem;border-radius:3px;padding:1.3rem;margin:1.5rem 0;font-size:12.5px;color:var(--muted);line-height:1.85}
.callout strong{display:block;font-size:13.5px;margin-bottom:.4rem}

/* SVG ANIMATIONS */
@@keyframes steamflow{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-16}}
@@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes spincw{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes pistonlr{0%,100%{transform:translateX(0)}50%{transform:translateX(18px)}}
@@keyframes pistonrl{0%,100%{transform:translateX(18px)}50%{transform:translateX(0)}}
@@keyframes glow{0%,100%{opacity:.1}50%{opacity:.4}}
@@keyframes chainmove{to{stroke-dashoffset:-20}}
@@keyframes crosshead{0%,100%{transform:translateX(0)}50%{transform:translateX(20px)}}

.a-steam{stroke-dasharray:8,4;animation:steamflow 1.8s linear infinite}
.a-pulse{animation:pulse 1.4s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-spin{animation:spin 1.4s linear infinite}
.a-spincw{animation:spincw 1.4s linear infinite}
.a-pistonlr{animation:pistonlr .9s ease-in-out infinite}
.a-pistonrl{animation:pistonrl .9s ease-in-out infinite}
.a-glow{animation:glow 2s ease-in-out infinite}
.a-chain{stroke-dasharray:6,3;animation:chainmove 1s linear infinite}
.a-crosshead{animation:crosshead .9s ease-in-out infinite}

/* LEGEND */
.legend{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1rem 1.2rem;margin:1rem 0;font-size:10.5px;font-family:var(--font-m)}
.leg-item{display:flex;align-items:center;gap:.5rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.leg-dot{width:20px;height:3px;border-radius:2px}

/* CONCEPT FLAG */
.concept-list{background:var(--forge);border:1px solid #0d0d20;border-left:4px solid var(--elec);border-radius:3px;padding:1.4rem;margin:1.5rem 0}
.concept-list h4{font-family:var(--font-m);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--elec);margin-bottom:1rem}
.concept-list li{font-size:12px;color:var(--muted);margin-bottom:.5rem;list-style:none;padding-left:1rem;position:relative}
.concept-list li::before{content:'⚠';position:absolute;left:0;color:var(--elec);font-size:10px}

/* FOOTER */
.footer{background:var(--forge);border-top:1px solid #0d0d20;padding:1.5rem;text-align:center;font-family:var(--font-m);font-size:10px;color:#1a1a30;letter-spacing:.1em}

@@media(max-width:700px){.wrap{padding:2rem 1rem}.tab{min-width:120px;padding:.7rem .5rem}}
</style>
</head>
<body>

<!-- BANNER -->
<div class="banner">
  <div class="phase-pill">Phase 17 · Full Chassis Integration — Revised</div>
  <h1><span class="s">Chevy</span> <span class="h">Miasma</span> <span class="e">Decker 9000</span></h1>
  <p>
    Phase 17 revises and expands the full vehicle design. <strong>Rhombic drives removed.</strong>
    Crosshead guides added for piston alignment. Static gear engine box fully detailed.
    Pistons corrected — steam pushes pistons, pistons drive rails on wheels.
    New engine internals schematic, electrical schematic added. All three original schematics fully redrawn.
  </p>
</div>

<!-- TABS -->
<div class="tab-nav-wrap">
  <button class="scroll-btn left" onclick="scrollTabs(-200)">&#8592;</button>
  <div class="tab-nav" id="tabNav">
    <div class="tab a-front" onclick="showTab('front',this)">🔧 Front Compartment<br><small style="font-size:7px">Engine · Generator · Steering</small></div>
    <div class="tab" onclick="showTab('rear',this)">🔥 Rear Compartment<br><small style="font-size:7px">Boiler · Pistons · Water</small></div>
    <div class="tab" onclick="showTab('chassis',this)">🚗 Chassis Layout<br><small style="font-size:7px">Full Top-Down View</small></div>
    <div class="tab" onclick="showTab('engine',this)">⚙️ Engine Internals<br><small style="font-size:7px">Gear Box · Crosshead · Chain</small></div>
    <div class="tab" onclick="showTab('electrical',this)">⚡ Electrical Schematic<br><small style="font-size:7px">48V · Rear Compartment</small></div>
    <div class="tab" onclick="showTab('pressure',this)">📐 Pressure Tests<br><small style="font-size:7px">Pipe Loss · Power Budget</small></div>
    <div class="tab" onclick="showTab('thermal',this)">🌡 Temperature Tests<br><small style="font-size:7px">Arctic −30°F · Desert 120°F</small></div>
    <div class="tab" onclick="showTab('water',this)">💧 200-Mile Water Test<br><small style="font-size:7px">30 MPH · Consumption</small></div>
  </div>
  <button class="scroll-btn right" onclick="scrollTabs(200)">&#8594;</button>
</div>

<!-- ═══════════════════════ FRONT COMPARTMENT ═══ -->
<div class="panel active" id="panel-front">
<div class="wrap">
  <div class="eyebrow" style="color:var(--hydro)">Diagram 1 · Front Engine Compartment — Phase 17 Revised</div>
  <h2 class="section-title">Static Gear Engine Box · Generator Array · EPS · Air Brakes</h2>
  <p class="section-lead">
    Phase 17 revision: Rhombic drives completely removed. Static gear engine box replaces prior rail housing concept.
    Pistons now correctly driven by steam — piston rods connect via crosshead guides to wheel rails.
    Generator array remains top-of-engine quick-swap. Bevel gear front shaft drives chain to generator and alternator.
  </p>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--hydro)"></div>Hydraulic / wheel drive</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>Electrical / 48V</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--mech)"></div>Mechanical / shaft / chain</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--brake)"></div>Brake air lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--ctrl)"></div>PCW control</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>Condensate return</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 840" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="f-rg-eng" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#39ff14" stop-opacity=".12"/><stop offset="100%" stop-color="#39ff14" stop-opacity="0"/></radialGradient>
    <radialGradient id="f-rg-gen" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffd700" stop-opacity=".18"/><stop offset="100%" stop-color="#ffd700" stop-opacity="0"/></radialGradient>
    <filter id="f-fg"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="f-fy"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="f-fp"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="f-arr-s" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="f-arr-h" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#00e5ff"/></marker>
    <marker id="f-arr-e" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
    <marker id="f-arr-m" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ff8c00"/></marker>
    <marker id="f-arr-w" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#40e0d0"/></marker>
    <marker id="f-arr-p" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#b388ff"/></marker>
  </defs>
  <rect width="1400" height="840" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="12" fill="#00e5ff" font-family="Courier New" font-weight="700" letter-spacing="2" filter="url(#f-fb)">FRONT ENGINE COMPARTMENT — PHASE 17 REVISED — SIDE VIEW</text>

  <!-- Bay outline -->
  <rect x="40" y="34" width="1320" height="780" rx="12" fill="#04040c" stroke="#0d0d20" stroke-width="1.5" opacity=".8"/>

  <!-- FIREWALL right -->
  <rect x="1268" y="34" width="18" height="780" fill="#101020" stroke="#c0c8d0" stroke-width="1.5"/>
  <text x="1277" y="430" text-anchor="middle" font-size="9" fill="#c0c8d0" font-family="Courier New" transform="rotate(90,1277,430)">FIREWALL → PASSENGER COMPARTMENT</text>

  <!-- RADIATOR left -->
  <rect x="40" y="34" width="30" height="780" fill="#010810" stroke="#00e5ff" stroke-width="1.5" filter="url(#f-fb)"/>
  <text x="55" y="430" text-anchor="middle" font-size="8" fill="#00e5ff" font-family="Courier New" transform="rotate(-90,55,430)">RADIATOR · CONDENSATE RECOVERY</text>
  <!-- fins -->
  <line x1="40" y1="80" x2="70" y2="80" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="110" x2="70" y2="110" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="140" x2="70" y2="140" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="170" x2="70" y2="170" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="200" x2="70" y2="200" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="230" x2="70" y2="230" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="260" x2="70" y2="260" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="290" x2="70" y2="290" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="320" x2="70" y2="320" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="350" x2="70" y2="350" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="380" x2="70" y2="380" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="410" x2="70" y2="410" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="440" x2="70" y2="440" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="470" x2="70" y2="470" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="500" x2="70" y2="500" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="530" x2="70" y2="530" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="560" x2="70" y2="560" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="590" x2="70" y2="590" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="620" x2="70" y2="620" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="650" x2="70" y2="650" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="680" x2="70" y2="680" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="710" x2="70" y2="710" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="740" x2="70" y2="740" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="770" x2="70" y2="770" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>

  <!-- ═══ STATIC GEAR ENGINE BOX (bottom section) ═══ -->
  <rect x="90" y="520" width="680" height="270" rx="12" fill="#010a02" stroke="#39ff14" stroke-width="2.5" filter="url(#f-fg)"/>
  <ellipse cx="430" cy="655" rx="260" ry="70" fill="url(#f-rg-eng)" class="a-glow"/>
  <text x="430" y="545" text-anchor="middle" font-size="12" fill="#39ff14" font-family="Courier New" font-weight="700">STATIC GEAR ENGINE BOX</text>
  <text x="430" y="560" text-anchor="middle" font-size="8.5" fill="#004020" font-family="Courier New">sealed · oil bath · grey iron EN-GJL-250 · LOW MOUNT</text>

  <!-- 3 cross shafts with wheels and gears -->
  <!-- Shaft 1 -->
  <rect x="110" y="590" width="560" height="20" rx="5" fill="#020c10" stroke="#39ff14" stroke-width="1.5"/>
  <circle cx="200" cy="600" r="16" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:200px 600px"/>
  <circle cx="360" cy="600" r="16" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:360px 600px;animation-delay:.1s"/>
  <circle cx="520" cy="600" r="16" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:520px 600px;animation-delay:.2s"/>
  <!-- Center sync gears shaft 1 -->
  <circle cx="340" cy="600" r="10" fill="#ff8c00" opacity=".4" style="animation:spin .5s linear infinite;transform-origin:340px 600px"/>
  <text x="430" y="578" text-anchor="middle" font-size="8" fill="#004020" font-family="Courier New">CROSS SHAFT 1 — L WHEEL · SYNC GEAR · R WHEEL</text>

  <!-- Shaft 2 -->
