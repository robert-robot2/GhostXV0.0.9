<script>
    (function() {
        'use strict';
        // Animate gauge needle on the boiler PSI display
        // (static for phase 11 — will be interactive in phase 12)
        const needle = document.getElementById('p11-gauge-needle');
        const psiDisp = document.getElementById('p11-psi-disp');
        if (needle && psiDisp) {
            // Show 90 PSI (cruise point — most realistic Phase 10 condition)
            const psi = 90;
            const angle = ((psi - 20) / 130) * 130 - 65;
            const rad = angle * Math.PI / 180;
            const cx = 1130, cy = 165, len = 30;
            const x2 = cx + Math.sin(rad) * len;
            const y2 = cy - Math.cos(rad) * len;
            needle.setAttribute('x2', x2.toFixed(1));
            needle.setAttribute('y2', y2.toFixed(1));
            psiDisp.textContent = psi;
        }
    })();
</script>

