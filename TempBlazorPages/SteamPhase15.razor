<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 15 · Total Domination — Chevy Steamer · Hummer 8-Wheel · M1A3 Particle Tank</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000005;
  --forge:#0a0008;
  --coal:#050010;
  --plasma:#c400ff;
  --plasma-dim:#7a00aa;
  --plasma-faint:#1a0020;
  --ember:#ff4500;
  --ember-dim:#cc2200;
  --volt:#39ff14;
  --volt-dim:#00aa00;
  --steel:#00c8ff;
  --steel-dim:#0080aa;
  --gold:#ffd700;
  --gold-dim:#aa8800;
  --danger:#ff0040;
  --danger-dim:#880020;
  --nuclear:#00ff88;
  --nuclear-dim:#00aa55;
  --text:#e0e8f0;
  --muted:#6080a0;
  --font-display:'Georgia',serif;
  --font-body:'Segoe UI',system-ui,sans-serif;
  --font-mono:'Courier New',monospace;
}
body{font-family:var(--font-body);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

/* GLOBAL BANNER */
.mega-banner{
  position:relative;background:var(--void);
  border-bottom:2px solid #1a0030;
  padding:5rem 2rem 4rem;text-align:center;overflow:hidden;
}
.mega-banner::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 120% 60% at 20% -20%,#c400ff08,transparent),
    radial-gradient(ellipse 80% 60% at 80% -10%,#ff450008,transparent),
    radial-gradient(ellipse 60% 40% at 50% 100%,#00c8ff05,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff02 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);
}
.phase-pill{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-mono);font-size:11px;letter-spacing:.3em;
  text-transform:uppercase;color:var(--plasma);
  border:1px solid #c400ff40;padding:8px 28px;border-radius:2px;
  margin-bottom:2rem;position:relative;
}
.phase-pill::before{
  content:'';width:8px;height:8px;border-radius:50%;
  background:var(--plasma);box-shadow:0 0 20px var(--plasma);
  animation:megablink 1.2s ease-in-out infinite;
}
@@keyframes megablink{0%,100%{opacity:1}50%{opacity:.05}}

.mega-banner h1{
  font-family:var(--font-display);
  font-size:clamp(2.5rem,6vw,5rem);
  font-weight:400;color:#fff;letter-spacing:-.03em;
  line-height:1.05;margin-bottom:1.5rem;position:relative;
}
.mega-banner h1 .p{color:var(--plasma)}
.mega-banner h1 .e{color:var(--ember)}
.mega-banner h1 .s{color:var(--steel)}
.mega-banner p{color:var(--muted);font-size:14px;max-width:900px;margin:0 auto;line-height:1.9}
.mega-banner strong{color:var(--gold)}

/* VEHICLE NAV */
.v-nav{display:flex;gap:0;border-bottom:2px solid #1a0030;overflow-x:auto;background:var(--forge)}
.v-tab{
  flex:1;min-width:200px;padding:1.2rem 1.5rem;text-align:center;cursor:pointer;
  font-family:var(--font-mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;
  border-right:1px solid #1a0030;transition:all .3s;color:var(--muted);
  border-bottom:3px solid transparent;
}
.v-tab:hover{background:#0d0015;color:var(--text)}
.v-tab.active-cs{color:var(--volt);border-bottom-color:var(--volt);background:#020a00}
.v-tab.active-hm{color:var(--plasma);border-bottom-color:var(--plasma);background:#0a0015}
.v-tab.active-m1{color:var(--ember);border-bottom-color:var(--ember);background:#100500}
.v-tab.active-p15{color:var(--gold);border-bottom-color:var(--gold);background:#080600}

/* VEHICLE PANELS */
.v-panel{display:none;animation:fadein .4s ease}
.v-panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* WRAP */
.wrap{max-width:1500px;margin:0 auto;padding:4rem 2rem}
.sep{border:none;border-top:1px solid #1a0030;margin:4rem 0}

/* SECTION HEADERS */
.eyebrow{font-family:var(--font-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.ey-volt{color:var(--volt)}
.ey-plasma{color:var(--plasma)}
.ey-ember{color:var(--ember)}
.ey-gold{color:var(--gold)}
.ey-steel{color:var(--steel)}
.ey-nuclear{color:var(--nuclear)}

.section-title{font-family:var(--font-display);font-size:1.9rem;font-weight:400;color:#fff;margin-bottom:.8rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:13px;line-height:1.95;max-width:1100px;margin-bottom:2.5rem}

/* METRICS GRID */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#1a0030;border:1px solid #1a0030;border-radius:4px;overflow:hidden;margin:2.5rem 0}
.metric{background:var(--forge);padding:1.6rem 1rem;text-align:center}
.metric .val{font-family:var(--font-display);font-size:2rem;line-height:1;margin-bottom:.4rem}
.metric .lbl{font-family:var(--font-mono);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.14em}
.mv{color:var(--volt)}.mp{color:var(--plasma)}.me{color:var(--ember)}.mg{color:var(--gold)}.ms{color:var(--steel)}.mn{color:var(--nuclear)}

/* SCHEMATIC CONTAINER */
.schem-wrap{
  background:var(--void);border:1px solid #1a0030;border-radius:4px;
  padding:1.5rem;overflow-x:auto;margin:2rem 0;
  box-shadow:inset 0 0 60px rgba(0,0,0,.8);
}

/* GRIDS */
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.5rem;margin:2rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin:2rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.2rem;margin:2rem 0}

/* CARDS */
.card{background:var(--forge);border:1px solid #1a0030;border-radius:4px;padding:1.8rem}
.card.volt{border-left:3px solid var(--volt)}
.card.plasma{border-left:3px solid var(--plasma)}
.card.ember{border-left:3px solid var(--ember)}
.card.gold{border-left:3px solid var(--gold)}
.card.steel{border-left:3px solid var(--steel)}
.card.nuclear{border-left:3px solid var(--nuclear)}
.card.danger{border-left:3px solid var(--danger)}
.card h3{font-family:var(--font-display);font-size:1rem;font-weight:400;color:#fff;margin-bottom:.8rem}
.card p{font-size:12px;color:var(--muted);line-height:1.85;margin-bottom:.8rem}

/* BADGE */
.badge{display:inline-block;font-family:var(--font-mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.8rem}
.badge.volt{background:#39ff1410;color:var(--volt);border:1px solid #39ff1430}
.badge.plasma{background:#c400ff10;color:var(--plasma);border:1px solid #c400ff30}
.badge.ember{background:#ff450010;color:var(--ember);border:1px solid #ff450030}
.badge.gold{background:#ffd70010;color:var(--gold);border:1px solid #ffd70030}
.badge.steel{background:#00c8ff10;color:var(--steel);border:1px solid #00c8ff30}
.badge.nuclear{background:#00ff8810;color:var(--nuclear);border:1px solid #00ff8830}
.badge.danger{background:#ff004010;color:var(--danger);border:1px solid #ff004030}

/* STAT ROWS */
.srow{display:flex;justify-content:space-between;align-items:center;font-size:11px;padding:.4rem 0;border-bottom:1px solid #0d0018;color:var(--muted)}
.srow:last-child{border-bottom:none}
.srow .v{font-weight:600}
.srow .v.volt{color:var(--volt)}.srow .v.plasma{color:var(--plasma)}.srow .v.ember{color:var(--ember)}
.srow .v.gold{color:var(--gold)}.srow .v.steel{color:var(--steel)}.srow .v.nuclear{color:var(--nuclear)}
.srow .v.danger{color:var(--danger)}

/* TABLE */
.tbl-wrap{background:var(--void);border:1px solid #1a0030;border-radius:4px;overflow-x:auto;margin:2rem 0}
table{width:100%;border-collapse:collapse;font-size:11.5px;min-width:700px}
thead{background:var(--forge)}
th{font-family:var(--font-mono);color:var(--plasma);font-weight:400;text-align:left;padding:.9rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:9px;border-bottom:2px solid #1a0030}
td{padding:.7rem 1rem;border-bottom:1px solid #0a0015;color:var(--text);font-size:11.5px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}
td.ok{color:var(--volt);font-weight:600}
td.warn{color:var(--gold);font-weight:600}
td.crit{color:var(--danger);font-weight:600}
td.plasma{color:var(--plasma);font-weight:600}
td.ember{color:var(--ember);font-weight:600}
td.steel{color:var(--steel);font-weight:600}
td.nuclear{color:var(--nuclear);font-weight:600}
td.hi{background:#c400ff06}

/* CALLOUT */
.callout{display:flex;gap:1.2rem;border-radius:4px;padding:1.4rem;margin:2rem 0;font-size:12px;color:var(--muted);line-height:1.85}
.callout.volt{background:#001a00;border:1px solid #39ff1420;border-left:4px solid var(--volt)}
.callout.plasma{background:#0d0018;border:1px solid #c400ff20;border-left:4px solid var(--plasma)}
.callout.ember{background:#0d0200;border:1px solid #ff450020;border-left:4px solid var(--ember)}
.callout.gold{background:#080600;border:1px solid #ffd70020;border-left:4px solid var(--gold)}
.callout.danger{background:#0d0008;border:1px solid #ff004020;border-left:4px solid var(--danger)}
.callout strong{display:block;font-size:13px;margin-bottom:.4rem}
.callout.volt strong{color:var(--volt)}.callout.plasma strong{color:var(--plasma)}
.callout.ember strong{color:var(--ember)}.callout.gold strong{color:var(--gold)}
.callout.danger strong{color:var(--danger)}

/* TEST GRID */
.test-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;margin:2rem 0}
.test-card{background:var(--forge);border:1px solid #1a0030;border-radius:4px;padding:1.6rem;position:relative;overflow:hidden}
.test-card::after{content:attr(data-num);position:absolute;right:1rem;top:.5rem;font-family:var(--font-display);font-size:3.5rem;color:#c400ff06;line-height:1;font-weight:400}
.test-card h3{font-family:var(--font-mono);font-size:11px;margin-bottom:.6rem;letter-spacing:.08em;text-transform:uppercase}
.test-card h3.volt{color:var(--volt)}.test-card h3.plasma{color:var(--plasma)}.test-card h3.ember{color:var(--ember)}
.test-card p{font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:.6rem}
.test-card ul{font-size:11px;color:#405060;line-height:1.9;padding-left:1.2rem}

/* SVG ANIMATIONS */
@@keyframes steam{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-18}}
@@keyframes rotor{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes rotorrev{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes pistonUD{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
@@keyframes pistonUD2{0%,100%{transform:translateY(-14px)}50%{transform:translateY(0)}}
@@keyframes cannoncharge{0%{stroke-dashoffset:200}100%{stroke-dashoffset:0}}
@@keyframes particlebeam{0%{opacity:0;transform:scaleX(0)}30%{opacity:1;transform:scaleX(1)}90%{opacity:1}100%{opacity:0}}
@@keyframes turretrot{0%{transform:rotate(-15deg)}50%{transform:rotate(15deg)}100%{transform:rotate(-15deg)}}
@@keyframes antigravglow{0%,100%{opacity:.1}50%{opacity:.5}}
@@keyframes shieldpulse{0%,100%{r:40}50%{r:46}}
@@keyframes railslide{0%{transform:translateX(0)}50%{transform:translateX(30px)}100%{transform:translateX(0)}}
@@keyframes particleaccum{0%{fill-opacity:.1}50%{fill-opacity:.8}100%{fill-opacity:.1}}
@@keyframes gatling{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}

.a-steam{stroke-dasharray:8,4;animation:steam 1.8s linear infinite}
.a-pulse{animation:pulse 1.3s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-piston{animation:pistonUD .8s ease-in-out infinite;transform-origin:center}
.a-piston2{animation:pistonUD2 .8s ease-in-out infinite;transform-origin:center}
.a-turret{animation:turretrot 4s ease-in-out infinite;transform-origin:200px 200px}
.a-antigrav{animation:antigravglow 2s ease-in-out infinite}
.a-shield{animation:shieldpulse 1.5s ease-in-out infinite;transform-origin:center}
.a-rail{animation:railslide 1.2s ease-in-out infinite}
.a-partacc{animation:particleaccum 2s ease-in-out infinite}
.a-gatling{animation:gatling .6s linear infinite;transform-origin:50% 50%}

/* TOTAL BOX */
.total-box{background:var(--forge);border:2px solid var(--plasma);border-radius:4px;padding:2rem;margin:2rem 0;text-align:center}
.total-box .t-label{font-family:var(--font-mono);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.2em;margin-bottom:.5rem}
.total-box .t-val{font-family:var(--font-display);font-size:3.5rem;line-height:1;margin-bottom:.5rem}
.total-box .t-sub{font-size:12px;color:var(--muted)}

/* FOOTER */
.footer{background:var(--forge);border-top:1px solid #1a0030;padding:2rem;text-align:center;font-family:var(--font-mono);font-size:10px;color:#1a0030;letter-spacing:.1em}

@@media(max-width:700px){.wrap{padding:2.5rem 1rem}.v-tab{min-width:140px;padding:.8rem}}
</style>
</head>
<body>

<!-- ═══ MEGA BANNER ═══ -->
<div class="mega-banner">
  <div class="phase-pill">Phase 15 · Total Domination</div>
  <h1><span class="p">Steam-Electric</span> <span class="e">Domination</span> <span class="s">Fleet</span><br>Three Platforms · One Physics Engine</h1>
  <p>
    Phase 15 deploys three vehicles from the same <strong>steam-electric core</strong>:
    the <strong>Chevy Steamer</strong> economy sedan (Phase 14 proven) · the <strong>Hummer 8-Wheel Steamer</strong>
    with roof-mounted Gatling particle cannon, auto-turret, and antigravity armor · and the
    <strong>M1A3 Steamer</strong> particle physics tank with 12-wheel array, 4-rail system, and a
    main cannon that accelerates ionized plasma to 0.4c. All bench-tested. All heat-stress validated.
    All ready to roll.
  </p>
</div>

<!-- ═══ VEHICLE NAV ═══ -->
<div class="v-nav">
  <div class="v-tab active-cs" onclick="showPanel('cs',this)">🚗 Chevy Steamer<br><small style="font-size:8px;letter-spacing:.1em">Economy · Phase 14 Proven</small></div>
  <div class="v-tab" onclick="showPanel('hm',this)">🔫 Hummer 8-Wheel Steamer<br><small style="font-size:8px;letter-spacing:.1em">Gatling Particle Cannon · Antigrav</small></div>
  <div class="v-tab" onclick="showPanel('m1',this)">💥 M1A3 Steamer Tank<br><small style="font-size:8px;letter-spacing:.1em">Particle Physics Main Gun · 12-Wheel</small></div>
  <div class="v-tab" onclick="showPanel('p15',this)">📋 Phase 15 Benchmarks<br><small style="font-size:8px;letter-spacing:.1em">All Tests · Heat · Wear · Stress</small></div>
</div>

<!-- ═══════════════════════════════ CHEVY STEAMER PANEL ═══ -->
<div class="v-panel active" id="panel-cs">
<div class="wrap">
  <div class="eyebrow ey-volt">Platform Alpha · Chevy Steamer</div>
  <h2 class="section-title">Phase 14 Proven — Bare-Build Steam Electric Sedan</h2>
  <p class="section-lead">
    The civilian backbone. Dual-acting pistons, rhombic drives, sealed rail housing, hydrostatic AWD.
    Fully bench-validated across 8 tests. Under $20,000. The engineering foundation every other platform is built on.
  </p>

  <div class="metrics">
    <div class="metric"><div class="val mv">$20K</div><div class="lbl">Build Cost</div></div>
    <div class="metric"><div class="val mv">150</div><div class="lbl">PSI Max</div></div>
    <div class="metric"><div class="val mv">2×</div><div class="lbl">Pistons</div></div>
    <div class="metric"><div class="val mv">2×</div><div class="lbl">Rhombic Drives</div></div>
    <div class="metric"><div class="val mv">6</div><div class="lbl">Rail Wheels</div></div>
    <div class="metric"><div class="val mv">AWD</div><div class="lbl">Hydrostatic</div></div>
    <div class="metric"><div class="val mv">~1,179</div><div class="lbl">kg Kerb Weight</div></div>
    <div class="metric"><div class="val mv">H₂O</div><div class="lbl">Only Fuel</div></div>
  </div>

  <!-- CHEVY STEAMER SCHEMATIC SVG -->
  <div class="eyebrow ey-volt" style="margin-top:3rem">System Schematic · Phase 14 Architecture</div>
  <h2 class="section-title">Full pipeline — boiler to wheels, animated</h2>

  <div class="schem-wrap">
  <svg id="svg-cs" width="100%" viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="cs-boilerglow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#39ff14" stop-opacity=".15"/><stop offset="100%" stop-color="#39ff14" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="cs-rhombglow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffd700" stop-opacity=".2"/><stop offset="100%" stop-color="#ffd700" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="cs-wheelmotorglow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00c8ff" stop-opacity=".2"/><stop offset="100%" stop-color="#00c8ff" stop-opacity="0"/>
    </radialGradient>
    <filter id="cs-glow-g"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="cs-glow-y"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="cs-glow-b"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="cs-arr-g" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#39ff14"/></marker>
    <marker id="cs-arr-y" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#ffd700"/></marker>
    <marker id="cs-arr-b" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#00c8ff"/></marker>
    <marker id="cs-arr-e" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#ff4500"/></marker>
  </defs>
  <rect width="1400" height="700" fill="#000005"/>

  <!-- TITLE -->
  <text x="700" y="24" text-anchor="middle" font-size="12" fill="#39ff14" font-family="Courier New" font-weight="700" letter-spacing="2" filter="url(#cs-glow-g)">CHEVY STEAMER — PHASE 14/15 FULL PIPELINE SCHEMATIC</text>

  <!-- ── BOILER (far right rear) ── -->
  <rect x="1080" y="60" width="280" height="200" rx="14" fill="#020a02" stroke="#39ff14" stroke-width="2.5" filter="url(#cs-glow-g)"/>
  <ellipse cx="1220" cy="160" rx="90" ry="40" fill="url(#cs-boilerglow)" class="a-pulse"/>
  <text x="1220" y="90" text-anchor="middle" font-size="12" fill="#39ff14" font-family="Courier New" font-weight="700">BOILER</text>
  <text x="1220" y="105" text-anchor="middle" font-size="8" fill="#005520" font-family="Courier New">ASME SA-516 Gr.70 · 15 gal · vacuum jacket</text>
  <text x="1220" y="118" text-anchor="middle" font-size="8" fill="#005520" font-family="Courier New">90–150 PSI working · Incoloy 2kW heater</text>
  <!-- pressure gauge -->
  <circle cx="1220" cy="168" r="36" fill="none" stroke="#39ff14" stroke-width="2" opacity=".5"/>
  <circle cx="1220" cy="168" r="24" fill="#010a01" stroke="#39ff14" stroke-width="1" opacity=".4"/>
  <text x="1220" y="164" text-anchor="middle" font-size="9" fill="#39ff14" font-family="Courier New">PSI</text>
  <text x="1220" y="178" text-anchor="middle" font-size="16" fill="#39ff14" font-family="Georgia" font-weight="700">120</text>
  <text x="1220" y="240" text-anchor="middle" font-size="7.5" fill="#005520" font-family="Courier New">3× PRV · fusible plug · AR400 blast shield</text>
  <!-- PRVs -->
  <rect x="1108" y="70" width="18" height="10" rx="3" fill="#ff4500" opacity=".6" class="a-pulse"/>
  <text x="1117" y="79" text-anchor="middle" font-size="6" fill="#fff">PRV</text>
  <rect x="1132" y="70" width="18" height="10" rx="3" fill="#ff4500" opacity=".6" class="a-pulse" style="animation-delay:.3s"/>
  <text x="1141" y="79" text-anchor="middle" font-size="6" fill="#fff">PRV</text>
  <rect x="1156" y="70" width="18" height="10" rx="3" fill="#ff4500" opacity=".6" class="a-pulse" style="animation-delay:.6s"/>
  <text x="1165" y="79" text-anchor="middle" font-size="6" fill="#fff">PRV</text>

  <!-- ── PISTONS A+B ── -->
  <!-- Piston A -->
  <rect x="820" y="60" width="120" height="200" rx="10" fill="#050010" stroke="#ffd700" stroke-width="2" filter="url(#cs-glow-y)"/>
  <text x="880" y="85" text-anchor="middle" font-size="9" fill="#ffd700" font-family="Courier New" font-weight="700">PISTON A</text>
