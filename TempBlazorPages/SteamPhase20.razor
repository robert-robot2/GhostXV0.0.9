  <tr><td style="color:var(--elec)">3rd</td><td>2:1 × 3.5:1</td><td>200 RPM</td><td>~28 RPM</td><td>~16 MPH</td><td>~11,400 Nm est.</td></tr>
  <tr><td style="color:var(--elec)">4th</td><td>1.2:1 × 3.5:1</td><td>200 RPM</td><td>~47 RPM</td><td>~27 MPH</td><td>~6,800 Nm est.</td></tr>
  <tr><td style="color:var(--elec)">4th hi</td><td>1.2:1 × 3.5:1</td><td>200 RPM (EWI boosted)</td><td>~57 RPM</td><td>~32 MPH</td><td>~6,800 Nm est.</td></tr>
