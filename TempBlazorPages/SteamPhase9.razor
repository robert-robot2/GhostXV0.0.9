<script>
(function() {
    'use strict';

    const get = id => document.getElementById(id);

    const sliders = [
        { id: 'p9-pack',        out: 'p9-pack-out',       fmt: v => v + ' kWh' },
        { id: 'p9-soc',         out: 'p9-soc-out',        fmt: v => v + '%' },
        { id: 'p9-heater',      out: 'p9-heater-out',     fmt: v => (+v).toLocaleString() + ' W' },
        { id: 'p9-speed',       out: 'p9-speed-out',      fmt: v => v + ' mph' },
        { id: 'p9-gen-eff',     out: 'p9-gen-eff-out',    fmt: v => v + '%' },
        { id: 'p9-gen-count',   out: 'p9-gen-count-out',  fmt: v => v },
        { id: 'p9-teg',         out: 'p9-teg-out',        fmt: v => (+v).toLocaleString() + ' W' },
        { id: 'p9-flywheel',    out: 'p9-flywheel-out',   fmt: v => (+v).toLocaleString() + ' Wh' },
        { id: 'p9-cap',         out: 'p9-cap-out',        fmt: v => (+v).toLocaleString() + ' W' },
        { id: 'p9-weight',      out: 'p9-weight-out',     fmt: v => (+v).toLocaleString() + ' lb' },
    ];

    sliders.forEach(s => {
        const el = get(s.id);
        if (!el) return;
        el.addEventListener('input', () => {
            const out = get(s.out);
            if (out) out.textContent = s.fmt(el.value);
            recalc();
        });
    });

    function fmtK(n) {
        if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
        return Math.round(n).toString();
    }
    function setText(id, v) { const e = get(id); if (e) e.textContent = v; }
    function setW(id, pct) {
        const e = get(id);
        if (e) e.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }

    function recalc() {
        const packKwh    = +(get('p9-pack')?.value      || 40);
        const soc        = +(get('p9-soc')?.value       || 90) / 100;
        const heaterW    = +(get('p9-heater')?.value    || 4200);
        const speedMph   = +(get('p9-speed')?.value     || 55);
        const genEff     = +(get('p9-gen-eff')?.value   || 50) / 100;
        const genCount   = +(get('p9-gen-count')?.value || 6);
        const tegW       = +(get('p9-teg')?.value       || 1000);
        const flywheelWh = +(get('p9-flywheel')?.value  || 800);
        const capW       = +(get('p9-cap')?.value       || 2000);

        // Generator output: 6 units × 9600W raw × efficiency × active count / 6
        const rawPerGen  = 9600;
        const genOutputW = rawPerGen * genCount * genEff;

        // Total energy input
        const totalInW   = genOutputW + tegW + capW;

        // Net balance (positive = surplus going to battery)
        const netW       = totalInW - heaterW;

        // Range calculation
        const availableKwh = packKwh * soc;
        const netDrawKw  = netW < 0 ? Math.abs(netW) / 1000 : 0;
        const rangeMiles = netDrawKw > 0
            ? Math.min(999, Math.round((availableKwh / netDrawKw) * speedMph))
            : 9999;

        const hoursAtSpeed = netDrawKw > 0
            ? (availableKwh / netDrawKw).toFixed(1)
            : '∞';

        // Sustainability
        const sustainPct = Math.round((totalInW / heaterW) * 100);
        const isSustained = netW >= 0;

        // Update metric cards
        setText('p9-mc-gen',      fmtK(genOutputW) + ' W');
        setText('p9-mc-total-in', fmtK(totalInW) + ' W');
        setText('p9-mc-net',      (netW >= 0 ? '+' : '') + fmtK(netW) + ' W');
        setText('p9-mc-range',    rangeMiles >= 9999 ? '∞ mi' : rangeMiles + ' mi');
        setText('p9-mc-sustain',  isSustained ? '✓ YES' : '✗ NO');
        setText('p9-mc-hours',    hoursAtSpeed + ' hrs');

        // Sustainability bar
        setW('p9-sustain-bar', sustainPct);
        setText('p9-sustain-pct-label', sustainPct + '%');

        // Update sustain card colour
        const sustCard = document.querySelector('#p9-mc-sustain')?.closest('.p9-mc');
        if (sustCard) {
            sustCard.style.borderColor = isSustained ? '#00FFD1' : '#DC143C';
        }
        const sustVal = get('p9-mc-sustain');
        if (sustVal) sustVal.style.color = isSustained ? '#00FFD1' : '#DC143C';

        // Balance bars
        const norm = v => Math.min(100, Math.round((v / Math.max(1, heaterW)) * 100));
        setW('p9-b-heater', 100);
        setW('p9-b-gen',  norm(genOutputW));
        setW('p9-b-teg',  norm(tegW));
        setW('p9-b-cap',  norm(capW));
        setW('p9-b-net',  norm(Math.abs(netW)));

        setText('p9-bv-heater', fmtK(heaterW) + ' W');
        setText('p9-bv-gen',   fmtK(genOutputW) + ' W');
        setText('p9-bv-teg',   fmtK(tegW) + ' W');
        setText('p9-bv-cap',   fmtK(capW) + ' W');
        setText('p9-bv-net',   (netW >= 0 ? '+' : '') + fmtK(netW) + ' W');

        // Battery bar
        const batBarEl = get('p9-batA-bar');
        if (batBarEl) batBarEl.setAttribute('width', Math.round(soc * 180));
        setText('p9-batA-pct', Math.round(soc * 100) + '%');
    }

    // Init
    sliders.forEach(s => {
        const el = get(s.id);
        const out = get(s.out);
        if (el && out) out.textContent = s.fmt(el.value);
    });
    recalc();

})();
</script>

