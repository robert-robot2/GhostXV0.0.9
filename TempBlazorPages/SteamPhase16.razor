<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 16 · Chevy Steamer — Full Chassis Integration</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000008;
  --forge:#06060e;
  --deep:#0a0a14;
  /* SYSTEM COLORS — one per system, all readable on black */
  --steam:#39ff14;        /* steam / boiler */
  --hydro:#00e5ff;        /* hydraulic / wheels */
  --elec:#ffd700;         /* electrical / power */
  --mech:#ff8c00;         /* mechanical / rhombic / CVT */
  --brake:#ff6ec7;        /* brakes — hot pink, visible on black */
  --ctrl:#b388ff;         /* PCW / control */
  --therm:#ff6b35;        /* thermal / exhaust */
  --water:#40e0d0;        /* water / condensate */
  --struct:#c0c8d0;       /* structural / chassis labels */
  --safe:#ff4500;         /* safety — PRV, shields */
  --text:#e8eef4;
  --muted:#6080a0;
  --font-d:'Georgia',serif;
  --font-b:'Segoe UI',system-ui,sans-serif;
  --font-m:'Courier New',monospace;
}
body{font-family:var(--font-b);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

/* BANNER */
.banner{
  position:relative;background:var(--void);
  border-bottom:2px solid #0d0d20;
  padding:5rem 2rem 4rem;text-align:center;overflow:hidden;
}
.banner::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse 100% 50% at 20% -10%,#39ff1406,transparent),
    radial-gradient(ellipse 80% 50% at 80% -10%,#00e5ff05,transparent),
    radial-gradient(ellipse 60% 40% at 50% 110%,#ffd70004,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff01 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);
}
.phase-pill{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-m);font-size:11px;letter-spacing:.28em;
  text-transform:uppercase;color:var(--steam);
  border:1px solid #39ff1440;padding:8px 28px;border-radius:2px;
  margin-bottom:2rem;position:relative;
}
.phase-pill::before{
  content:'';width:8px;height:8px;border-radius:50%;
  background:var(--steam);box-shadow:0 0 20px var(--steam);
  animation:blink 1.2s ease-in-out infinite;
}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.05}}
.banner h1{
  font-family:var(--font-d);
  font-size:clamp(2.2rem,5vw,4.2rem);
  font-weight:400;color:#fff;letter-spacing:-.03em;
  line-height:1.05;margin-bottom:1.5rem;position:relative;
}
.banner h1 .s{color:var(--steam)}
.banner h1 .h{color:var(--hydro)}
.banner h1 .e{color:var(--elec)}
.banner p{color:var(--muted);font-size:13.5px;max-width:980px;margin:0 auto;line-height:1.95}
.banner strong{color:var(--elec)}

/* NAV TABS */
.tab-nav{display:flex;gap:0;border-bottom:2px solid #0d0d20;background:var(--forge);overflow-x:auto}
.tab{
  flex:1;min-width:180px;padding:1.2rem 1rem;text-align:center;cursor:pointer;
  font-family:var(--font-m);font-size:9px;letter-spacing:.16em;text-transform:uppercase;
  border-right:1px solid #0d0d20;transition:all .25s;color:var(--muted);
  border-bottom:3px solid transparent;
}
.tab:hover{background:#0a0a18;color:var(--text)}
.tab.a-front{color:var(--hydro);border-bottom-color:var(--hydro);background:#00050a}
.tab.a-rear{color:var(--steam);border-bottom-color:var(--steam);background:#010800}
.tab.a-chassis{color:var(--elec);border-bottom-color:var(--elec);background:#080600}
.tab.a-pressure{color:var(--mech);border-bottom-color:var(--mech);background:#080400}
.tab.a-thermal{color:var(--brake);border-bottom-color:var(--brake);background:#080408}
.tab.a-water{color:var(--water);border-bottom-color:var(--water);background:#020808}

/* PANELS */
.panel{display:none;animation:fadein .35s ease}
.panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* WRAP */
.wrap{max-width:1500px;margin:0 auto;padding:3.5rem 2rem}
.sep{border:none;border-top:1px solid #0d0d20;margin:3.5rem 0}

/* EYEBROW + TITLE */
.eyebrow{font-family:var(--font-m);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:var(--font-d);font-size:1.7rem;font-weight:400;color:#fff;margin-bottom:.7rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:12.5px;line-height:1.95;max-width:1100px;margin-bottom:2rem}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#0d0d20;border:1px solid #0d0d20;border-radius:3px;overflow:hidden;margin:2rem 0}
.metric{background:var(--forge);padding:1.4rem .8rem;text-align:center}
.metric .val{font-family:var(--font-d);font-size:1.9rem;line-height:1;margin-bottom:.3rem}
.metric .lbl{font-family:var(--font-m);font-size:8.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.13em}

/* SCHEMATIC */
.schem{background:var(--void);border:1px solid #0d0d20;border-radius:3px;padding:1rem;overflow-x:auto;margin:1.5rem 0}

/* GRIDS */
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.4rem;margin:1.5rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin:1.5rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin:1.5rem 0}

/* CARDS */
.card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.6rem}
.card h3{font-family:var(--font-d);font-size:.95rem;font-weight:400;color:#fff;margin-bottom:.7rem}
.card p{font-size:11.5px;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.srow{display:flex;justify-content:space-between;font-size:11px;padding:.35rem 0;border-bottom:1px solid #0a0a18;color:var(--muted)}
.srow:last-child{border-bottom:none}
.srow .v{font-weight:600}

/* BADGE */
.badge{display:inline-block;font-family:var(--font-m);font-size:8.5px;letter-spacing:.13em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.7rem;border:1px solid}

/* TABLE */
.tbl{background:var(--void);border:1px solid #0d0d20;border-radius:3px;overflow-x:auto;margin:1.5rem 0}
table{width:100%;border-collapse:collapse;font-size:11.5px;min-width:600px}
thead{background:var(--forge)}
th{font-family:var(--font-m);font-weight:400;text-align:left;padding:.8rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:8.5px;border-bottom:2px solid #0d0d20;color:var(--struct)}
td{padding:.65rem 1rem;border-bottom:1px solid #0a0a18;color:var(--text);font-size:11.5px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}

/* CALLOUT */
.callout{display:flex;gap:1rem;border-radius:3px;padding:1.3rem;margin:1.5rem 0;font-size:12px;color:var(--muted);line-height:1.85}
.callout strong{display:block;font-size:13px;margin-bottom:.4rem}

/* SVG ANIMATIONS */
@@keyframes steamflow{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-16}}
@@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes spincw{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes pistonud{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@@keyframes pistonud2{0%,100%{transform:translateY(-12px)}50%{transform:translateY(0)}}
@@keyframes glow{0%,100%{opacity:.1}50%{opacity:.4}}
@@keyframes railslide{0%,100%{transform:translateX(0)}50%{transform:translateX(28px)}}

.a-steam{stroke-dasharray:8,4;animation:steamflow 1.8s linear infinite}
.a-pulse{animation:pulse 1.4s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-spin{animation:spin 1.4s linear infinite}
.a-spincw{animation:spincw 1.4s linear infinite}
.a-piston{animation:pistonud .8s ease-in-out infinite}
.a-piston2{animation:pistonud2 .8s ease-in-out infinite}
.a-glow{animation:glow 2s ease-in-out infinite}
.a-rail{stroke-dasharray:8,4;animation:railslide 1.2s ease-in-out infinite}

/* LEGEND */
.legend{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1rem 1.2rem;margin:1rem 0;font-size:10px;font-family:var(--font-m)}
.leg-item{display:flex;align-items:center;gap:.5rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.leg-dot{width:20px;height:3px;border-radius:2px}

/* FOOTER */
.footer{background:var(--forge);border-top:1px solid #0d0d20;padding:1.5rem;text-align:center;font-family:var(--font-m);font-size:9.5px;color:#1a1a30;letter-spacing:.1em}

@@media(max-width:700px){.wrap{padding:2rem 1rem}.tab{min-width:120px;padding:.7rem .5rem}}
</style>
</head>
<body>

<!-- BANNER -->
<div class="banner">
  <div class="phase-pill">Phase 16 · Full Chassis Integration</div>
  <h1><span class="s">Chevy Steamer</span> — <span class="h">Complete Vehicle</span><br><span class="e">Three Compartment Architecture</span></h1>
  <p>
    Phase 16 finalises the Chevy Steamer as a <strong>complete driveable vehicle</strong>. Three detailed schematics cover
    the front engine compartment, rear boiler compartment, and full chassis layout. Includes
    pressure loss validation for the ¾" steam pipe run, rhombic drive power confirmation,
    temperature extremes testing (Arctic −30°F to Desert 120°F), and a 200-mile / 30 MPH
    water consumption test. The generator array sits on top of the engine housing for quick-swap access.
  </p>
</div>

<!-- TABS -->
<div class="tab-nav">
  <div class="tab a-front" onclick="showTab('front',this)">🔧 Front Compartment<br><small style="font-size:7px;letter-spacing:.08em">Rails · Engine · Generator Array</small></div>
  <div class="tab" onclick="showTab('rear',this)">🔥 Rear Compartment<br><small style="font-size:7px;letter-spacing:.08em">Boiler · Pistons · Rhombic</small></div>
  <div class="tab" onclick="showTab('chassis',this)">🚗 Chassis Layout<br><small style="font-size:7px;letter-spacing:.08em">Full Top-Down View</small></div>
  <div class="tab" onclick="showTab('pressure',this)">📐 Pressure Tests<br><small style="font-size:7px;letter-spacing:.08em">Pipe Loss · Rhombic Power</small></div>
  <div class="tab" onclick="showTab('thermal',this)">🌡 Temperature Tests<br><small style="font-size:7px;letter-spacing:.08em">Arctic −30°F · Desert 120°F</small></div>
  <div class="tab" onclick="showTab('water',this)">💧 200-Mile Water Test<br><small style="font-size:7px;letter-spacing:.08em">30 MPH · Consumption Calc</small></div>
</div>

<!-- ═══════════════════════ FRONT COMPARTMENT ═══ -->
<div class="panel active" id="panel-front">
<div class="wrap">
  <div class="eyebrow" style="color:var(--hydro)">Diagram 1 · Front Engine Compartment</div>
  <h2 class="section-title">Rail Housing · Engine · Generator Array · Steering · Brakes</h2>
  <p class="section-lead">
    The front compartment sits low — the rail housing and engine housing mount well below a conventional engine height,
    leaving the full upper bay for the generator array, electric power steering unit, PCW controller,
    eddy coil exhaust sleeve, and service access. The ¾" steam inlet enters from the passenger-side tunnel.
  </p>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--hydro)"></div>Hydraulic / wheel drive</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>Electrical / power bus</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--mech)"></div>Mechanical / shaft</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--brake)"></div>Brake air lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--ctrl)"></div>PCW control</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>Condensate return</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 820" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="rg-rail" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#00e5ff" stop-opacity=".15"/><stop offset="100%" stop-color="#00e5ff" stop-opacity="0"/></radialGradient>
    <radialGradient id="rg-eng" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#39ff14" stop-opacity=".12"/><stop offset="100%" stop-color="#39ff14" stop-opacity="0"/></radialGradient>
    <radialGradient id="rg-gen" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffd700" stop-opacity=".18"/><stop offset="100%" stop-color="#ffd700" stop-opacity="0"/></radialGradient>
    <filter id="fg"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="fb"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="fy"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="fp"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="arr-s" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="arr-h" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#00e5ff"/></marker>
    <marker id="arr-e" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
    <marker id="arr-m" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ff8c00"/></marker>
    <marker id="arr-b" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ff6ec7"/></marker>
    <marker id="arr-w" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#40e0d0"/></marker>
    <marker id="arr-p" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#b388ff"/></marker>
  </defs>
  <rect width="1400" height="820" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="11" fill="#00e5ff" font-family="Courier New" font-weight="700" letter-spacing="2" filter="url(#fb)">FRONT ENGINE COMPARTMENT — SIDE/FRONT VIEW</text>

  <!-- ENGINE BAY OUTLINE -->
  <rect x="40" y="34" width="1320" height="750" rx="12" fill="#04040c" stroke="#0d0d20" stroke-width="1.5" opacity=".8"/>

  <!-- FIREWALL (right side) -->
  <rect x="1260" y="34" width="18" height="750" fill="#101020" stroke="#c0c8d0" stroke-width="1.5"/>
  <text x="1269" y="420" text-anchor="middle" font-size="8" fill="#c0c8d0" font-family="Courier New" transform="rotate(90,1269,420)">FIREWALL — PASSENGER COMPARTMENT →</text>

  <!-- RADIATOR (left/front wall) -->
  <rect x="40" y="34" width="30" height="750" fill="#010810" stroke="#00e5ff" stroke-width="1.5" filter="url(#fb)"/>
  <text x="55" y="420" text-anchor="middle" font-size="7.5" fill="#00e5ff" font-family="Courier New" transform="rotate(-90,55,420)">RADIATOR · CONDENSATE RECOVERY</text>
  <!-- fins -->
  <line x1="40" y1="80" x2="70" y2="80" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="110" x2="70" y2="110" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="140" x2="70" y2="140" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="170" x2="70" y2="170" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="200" x2="70" y2="200" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="230" x2="70" y2="230" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="260" x2="70" y2="260" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="290" x2="70" y2="290" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="320" x2="70" y2="320" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="350" x2="70" y2="350" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="380" x2="70" y2="380" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="410" x2="70" y2="410" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="440" x2="70" y2="440" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="470" x2="70" y2="470" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="500" x2="70" y2="500" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="530" x2="70" y2="530" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="560" x2="70" y2="560" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="590" x2="70" y2="590" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="620" x2="70" y2="620" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="650" x2="70" y2="650" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="680" x2="70" y2="680" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="710" x2="70" y2="710" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>
  <line x1="40" y1="740" x2="70" y2="740" stroke="#00e5ff" stroke-width=".5" opacity=".3"/>

  <!-- ═══ BOTTOM SECTION — RAIL HOUSING + ENGINE (LOW MOUNT) ═══ -->
  <!-- RAIL HOUSING -->
  <rect x="90" y="520" width="580" height="210" rx="10" fill="#010810" stroke="#00e5ff" stroke-width="2.5" filter="url(#fb)"/>
  <ellipse cx="380" cy="625" rx="220" ry="60" fill="url(#rg-rail)" class="a-glow"/>
  <text x="380" y="548" text-anchor="middle" font-size="11" fill="#00e5ff" font-family="Courier New" font-weight="700">RAIL HOUSING — SEALED MANIFOLD</text>
  <text x="380" y="562" text-anchor="middle" font-size="7.5" fill="#006680" font-family="Courier New">Grey iron EN-GJL-250 · steam environment · LOW MOUNT</text>
  <!-- Rail A -->
  <rect x="108" y="578" width="544" height="16" rx="4" fill="#050820" stroke="#00e5ff" stroke-width="1.5" class="a-rail"/>
  <text x="116" y="590" font-size="7.5" fill="#00e5ff" font-family="Courier New">RAIL A →</text>
  <circle cx="180" cy="586" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:180px 586px"/>
  <circle cx="270" cy="586" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:270px 586px;animation-delay:.12s"/>
  <circle cx="360" cy="586" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spin .7s linear infinite;transform-origin:360px 586px;animation-delay:.24s"/>
  <!-- Output shaft -->
  <rect x="108" y="598" width="544" height="12" rx="3" fill="#ff8c00" opacity=".25"/>
  <text x="380" y="608" text-anchor="middle" font-size="7" fill="#ff8c00" font-family="Courier New">CENTRAL OUTPUT SHAFT</text>
  <!-- Rail B -->
  <rect x="108" y="614" width="544" height="16" rx="4" fill="#050820" stroke="#00e5ff" stroke-width="1.5" style="animation:railslide 1.2s ease-in-out infinite reverse"/>
  <text x="116" y="626" font-size="7.5" fill="#00e5ff" font-family="Courier New">← RAIL B (180° offset)</text>
  <circle cx="210" cy="622" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spincw .7s linear infinite;transform-origin:210px 622px"/>
  <circle cx="300" cy="622" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spincw .7s linear infinite;transform-origin:300px 622px;animation-delay:.12s"/>
  <circle cx="390" cy="622" r="11" fill="none" stroke="#39ff14" stroke-width="2" style="animation:spincw .7s linear infinite;transform-origin:390px 622px;animation-delay:.24s"/>
  <text x="380" y="660" text-anchor="middle" font-size="7.5" fill="#004050" font-family="Courier New">180° offset → continuous torque · no dead spots</text>
  <text x="380" y="673" text-anchor="middle" font-size="7.5" fill="#004050" font-family="Courier New">2,500N/rail 90 PSI · 4,100N/rail 150 PSI</text>
  <!-- Rotary seal -->
  <rect x="660" y="596" width="22" height="30" rx="4" fill="#020010" stroke="#b388ff" stroke-width="2" filter="url(#fp)"/>
