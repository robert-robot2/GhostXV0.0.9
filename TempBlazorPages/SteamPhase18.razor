<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phase 18 · Chevy Miasma Decker 9000 · Engine Schematics</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --void:#000008;
  --forge:#06060e;
  --deep:#0a0a14;
  --steam:#39ff14;
  --hydro:#00e5ff;
  --elec:#ffd700;
  --mech:#ff8c00;
  --brake:#ff6ec7;
  --ctrl:#b388ff;
  --therm:#ff6b35;
  --water:#40e0d0;
  --struct:#c0c8d0;
  --safe:#ff4500;
  --text:#e8eef4;
  --muted:#6080a0;
  --worm:#c9a84c;
  --font-d:'Georgia',serif;
  --font-b:'Segoe UI',system-ui,sans-serif;
  --font-m:'Courier New',monospace;
}
body{font-family:var(--font-b);background:var(--void);color:var(--text);line-height:1.6;overflow-x:hidden}

/* BANNER */
.banner{position:relative;background:var(--void);border-bottom:2px solid #0d0d20;padding:5rem 2rem 4rem;text-align:center;overflow:hidden;}
.banner::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 100% 50% at 20% -10%,#39ff1406,transparent),
    radial-gradient(ellipse 80% 50% at 80% -10%,#c9a84c05,transparent),
    radial-gradient(ellipse 60% 40% at 50% 110%,#ff8c0004,transparent),
    repeating-linear-gradient(90deg,transparent,transparent 80px,#ffffff01 81px),
    repeating-linear-gradient(0deg,transparent,transparent 80px,#ffffff01 81px);}
.phase-pill{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-m);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--worm);border:1px solid #c9a84c40;padding:8px 28px;border-radius:2px;margin-bottom:2rem;position:relative;}
.phase-pill::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--worm);box-shadow:0 0 20px var(--worm);animation:blink 1.2s ease-in-out infinite;}
@@keyframes blink{0%,100%{opacity:1}50%{opacity:.05}}
.banner h1{font-family:var(--font-d);font-size:clamp(2rem,5vw,4rem);font-weight:400;color:#fff;letter-spacing:-.03em;line-height:1.05;margin-bottom:1.5rem;position:relative;}
.banner h1 .s{color:var(--steam)}.banner h1 .w{color:var(--worm)}.banner h1 .e{color:var(--elec)}
.banner p{color:var(--muted);font-size:13.5px;max-width:980px;margin:0 auto;line-height:1.95}
.banner strong{color:var(--worm)}

/* TABS */
.tab-nav-wrap{background:var(--forge);border-bottom:2px solid #0d0d20;position:relative;}
.tab-nav{display:flex;gap:0;overflow-x:auto;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:#1a1a30 var(--forge);}
.tab-nav::-webkit-scrollbar{height:4px}.tab-nav::-webkit-scrollbar-track{background:var(--forge)}.tab-nav::-webkit-scrollbar-thumb{background:#1a1a30;border-radius:2px}
.scroll-btn{position:absolute;top:0;bottom:0;width:36px;border:none;cursor:pointer;z-index:10;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:16px;transition:color .2s;}
.scroll-btn:hover{color:var(--text)}.scroll-btn.left{left:0;background:linear-gradient(90deg,var(--forge) 60%,transparent)}.scroll-btn.right{right:0;background:linear-gradient(270deg,var(--forge) 60%,transparent)}
.tab{flex:0 0 auto;min-width:180px;padding:1.1rem .9rem;text-align:center;cursor:pointer;font-family:var(--font-m);font-size:9px;letter-spacing:.14em;text-transform:uppercase;border-right:1px solid #0d0d20;transition:all .25s;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;}
.tab:hover{background:#0a0a18;color:var(--text)}
.tab.a-front{color:var(--hydro);border-bottom-color:var(--hydro);background:#00050a}
.tab.a-engine{color:var(--worm);border-bottom-color:var(--worm);background:#080600}
.tab.a-rear{color:var(--steam);border-bottom-color:var(--steam);background:#010800}
.tab.a-variants{color:var(--ctrl);border-bottom-color:var(--ctrl);background:#060010}

/* PANELS */
.panel{display:none;animation:fadein .35s ease}.panel.active{display:block}
@@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* LAYOUT */
.wrap{max-width:1500px;margin:0 auto;padding:3.5rem 2rem}
.sep{border:none;border-top:1px solid #0d0d20;margin:3.5rem 0}
.eyebrow{font-family:var(--font-m);font-size:10px;letter-spacing:.22em;text-transform:uppercase;margin-bottom:.5rem}
.section-title{font-family:var(--font-d);font-size:1.7rem;font-weight:400;color:#fff;margin-bottom:.7rem;letter-spacing:-.02em}
.section-lead{color:var(--muted);font-size:13px;line-height:1.95;max-width:1100px;margin-bottom:2rem}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1px;background:#0d0d20;border:1px solid #0d0d20;border-radius:3px;overflow:hidden;margin:2rem 0}
.metric{background:var(--forge);padding:1.4rem .8rem;text-align:center}
.metric .val{font-family:var(--font-d);font-size:1.9rem;line-height:1;margin-bottom:.3rem}
.metric .lbl{font-family:var(--font-m);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.13em}

/* SCHEMATIC */
.schem{background:var(--void);border:1px solid #0d0d20;border-radius:3px;padding:1rem;overflow-x:auto;margin:1.5rem 0}

/* GRIDS */
.g2{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:1.4rem;margin:1.5rem 0}
.g3{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.4rem;margin:1.5rem 0}
.g4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin:1.5rem 0}

/* CARDS */
.card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.6rem}
.card h3{font-family:var(--font-d);font-size:1rem;font-weight:400;color:#fff;margin-bottom:.7rem}
.card p{font-size:12px;color:var(--muted);line-height:1.85;margin-bottom:.7rem}
.srow{display:flex;justify-content:space-between;font-size:11.5px;padding:.35rem 0;border-bottom:1px solid #0a0a18;color:var(--muted)}
.srow:last-child{border-bottom:none}.srow .v{font-weight:600}

/* BADGE */
.badge{display:inline-block;font-family:var(--font-m);font-size:9px;letter-spacing:.13em;text-transform:uppercase;padding:3px 10px;border-radius:2px;margin-bottom:.7rem;border:1px solid}

/* TABLE */
.tbl{background:var(--void);border:1px solid #0d0d20;border-radius:3px;overflow-x:auto;margin:1.5rem 0}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:600px}
thead{background:var(--forge)}
th{font-family:var(--font-m);font-weight:400;text-align:left;padding:.8rem 1rem;text-transform:uppercase;letter-spacing:.1em;font-size:9px;border-bottom:2px solid #0d0d20;color:var(--struct)}
td{padding:.65rem 1rem;border-bottom:1px solid #0a0a18;color:var(--text);font-size:12px}
tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--forge)}

/* LEGEND */
.legend{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1rem 1.2rem;margin:1rem 0;font-size:10.5px;font-family:var(--font-m)}
.leg-item{display:flex;align-items:center;gap:.5rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.leg-dot{width:20px;height:3px;border-radius:2px}

/* CONCEPT FLAG */
.concept-list{background:var(--forge);border:1px solid #0d0d20;border-left:4px solid var(--elec);border-radius:3px;padding:1.4rem;margin:1.5rem 0}
.concept-list h4{font-family:var(--font-m);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--elec);margin-bottom:1rem}
.concept-list li{font-size:12px;color:var(--muted);margin-bottom:.5rem;list-style:none;padding-left:1rem;position:relative}
.concept-list li::before{content:'⚠';position:absolute;left:0;color:var(--elec);font-size:10px}

/* VARIANT CARDS */
.variant-card{background:var(--forge);border:1px solid #0d0d20;border-radius:3px;padding:1.8rem;position:relative;overflow:hidden}
.variant-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.variant-economy::before{background:var(--water)}
.variant-standard::before{background:var(--steam)}
.variant-racer::before{background:var(--safe)}
.variant-hauler::before{background:var(--elec)}
.variant-4wheel::before{background:var(--ctrl)}
.variant-8wheel::before{background:var(--mech)}

/* ANIMATIONS */
@@keyframes steamflow{to{stroke-dashoffset:-24}}
@@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
@@keyframes powerpulse{to{stroke-dashoffset:-16}}
@@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@@keyframes spincw{from{transform:rotate(360deg)}to{transform:rotate(0deg)}}
@@keyframes pistonlr{0%,100%{transform:translateX(0)}50%{transform:translateX(22px)}}
@@keyframes pistonrl{0%,100%{transform:translateX(22px)}50%{transform:translateX(0)}}
@@keyframes glow{0%,100%{opacity:.1}50%{opacity:.4}}
@@keyframes chainmove{to{stroke-dashoffset:-20}}
@@keyframes wormrotate{from{stroke-dashoffset:0}to{stroke-dashoffset:-40}}
@@keyframes railpush{0%,100%{transform:translateX(0)}50%{transform:translateX(18px)}}
@@keyframes railpull{0%,100%{transform:translateX(18px)}50%{transform:translateX(0)}}

.a-steam{stroke-dasharray:8,4;animation:steamflow 1.8s linear infinite}
.a-pulse{animation:pulse 1.4s ease-in-out infinite}
.a-power{stroke-dasharray:6,3;animation:powerpulse 1.4s linear infinite}
.a-spin{animation:spin 1s linear infinite}
.a-spincw{animation:spincw 1s linear infinite}
.a-glow{animation:glow 2s ease-in-out infinite}
.a-chain{stroke-dasharray:6,3;animation:chainmove 1s linear infinite}
.a-worm{stroke-dasharray:10,5;animation:wormrotate 1.2s linear infinite}

.footer{background:var(--forge);border-top:1px solid #0d0d20;padding:1.5rem;text-align:center;font-family:var(--font-m);font-size:10px;color:#1a1a30;letter-spacing:.1em}
@@media(max-width:700px){.wrap{padding:2rem 1rem}.tab{min-width:140px;padding:.7rem .5rem}}
</style>
</head>
<body>

<!-- BANNER -->
<div class="banner">
  <div class="phase-pill">Phase 18 · Engine Schematics — Worm Spine Architecture</div>
  <h1><span class="s">Chevy</span> <span class="w">Miasma</span> <span class="e">Decker 9000</span></h1>
  <p>
    Phase 18 focuses exclusively on engine internals. <strong>New: High-lead worm spine driveshaft.</strong>
    Three cylinder shaft helical gears drive a continuous high-lead worm driveshaft running front to back.
    Locomotive-style reciprocating rails. Six drive cylinders. Enclosed oil bath chain to generator.
    Test dimensions sized for Chevy Impala engine bay. CVT transmission deferred to Phase 19.
  </p>
</div>

<!-- TABS -->
<div class="tab-nav-wrap">
  <button class="scroll-btn left" onclick="scrollTabs(-200)">&#8592;</button>
  <div class="tab-nav" id="tabNav">
    <div class="tab a-front" onclick="showTab('front',this)">🔧 Front Compartment<br><small style="font-size:7px">Engine Overview · Generator · Rails</small></div>
    <div class="tab" onclick="showTab('engine',this)">⚙️ Engine Close-Up<br><small style="font-size:7px">Worm Spine · Cylinders · Gears</small></div>
    <div class="tab" onclick="showTab('rear',this)">🔥 Rear Boiler<br><small style="font-size:7px">Two Steam Pipes · Boiler · Updated</small></div>
    <div class="tab" onclick="showTab('variants',this)">🔀 Engine Variants<br><small style="font-size:7px">Economy · Racer · Hauler · 4W · 8W</small></div>
  </div>
  <button class="scroll-btn right" onclick="scrollTabs(200)">&#8594;</button>
</div>

<!-- ═══════════════════════ FRONT COMPARTMENT ═══ -->
<div class="panel active" id="panel-front">
<div class="wrap">
  <div class="eyebrow" style="color:var(--hydro)">Diagram 1 · Front Engine Compartment — Phase 18</div>
  <h2 class="section-title">Locomotive Rails · Six Cylinders · Worm Spine Driveshaft · Generator Chain</h2>
  <p class="section-lead">
    Phase 18 complete engine redesign. Two steam pistons drive reciprocating rails — one per side, locomotive style.
    Each rail drives three cylinder shafts. Each cylinder shaft has a precision helical gear at its center.
    Three helical gears drive a continuous high-lead worm spine driveshaft running front to back.
    Driveshaft exits rear to CVT transmission (Phase 19) and front to enclosed oil bath chain multiplier driving generator and alternator.
    All housed in sealed oil bath engine box. Test dimensions for Chevy Impala 1,219mm × 914mm engine bay.
  </p>

  <div class="metrics">
    <div class="metric"><div class="val" style="color:var(--steam)">2</div><div class="lbl">Steam Pistons</div></div>
    <div class="metric"><div class="val" style="color:var(--mech)">6</div><div class="lbl">Drive Cylinders</div></div>
    <div class="metric"><div class="val" style="color:var(--worm)">3</div><div class="lbl">Worm Sections</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">80mm</div><div class="lbl">Piston Bore</div></div>
    <div class="metric"><div class="val" style="color:var(--steam)">120mm</div><div class="lbl">Piston Stroke</div></div>
    <div class="metric"><div class="val" style="color:var(--mech)">150 PSI</div><div class="lbl">Max Steam</div></div>
    <div class="metric"><div class="val" style="color:var(--worm)">~1,800</div><div class="lbl">Nm Est. Torque</div></div>
    <div class="metric"><div class="val" style="color:var(--hydro)">200–400</div><div class="lbl">RPM Operating</div></div>
  </div>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--mech)"></div>Reciprocating rails</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--worm)"></div>Worm spine driveshaft</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>Electrical / generator</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--hydro)"></div>Cylinder shafts</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--ctrl)"></div>Helical gears</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>Oil bath / lubrication</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 860" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="fg-eng" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#c9a84c" stop-opacity=".15"/><stop offset="100%" stop-color="#c9a84c" stop-opacity="0"/></radialGradient>
    <radialGradient id="fg-gen" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffd700" stop-opacity=".18"/><stop offset="100%" stop-color="#ffd700" stop-opacity="0"/></radialGradient>
    <filter id="fg-g"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <filter id="fg-y"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="arr-s" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="arr-m" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ff8c00"/></marker>
    <marker id="arr-e" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
    <marker id="arr-w" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#c9a84c"/></marker>
    <marker id="arr-h" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#00e5ff"/></marker>
  </defs>
  <rect width="1400" height="860" fill="#000008"/>
  <text x="700" y="22" text-anchor="middle" font-size="12" fill="#c9a84c" font-family="Courier New" font-weight="700" letter-spacing="2">FRONT ENGINE COMPARTMENT — PHASE 18 — TOP DOWN VIEW</text>
  <text x="700" y="38" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">Chevy Impala Engine Bay · 1,219mm × 914mm · All dimensions test spec · modifiable</text>

  <!-- Engine bay outline -->
  <rect x="40" y="50" width="1320" height="780" rx="14" fill="#04040c" stroke="#0d0d20" stroke-width="1.5"/>

  <!-- FRONT label -->
  <text x="700" y="72" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← FRONT OF VEHICLE · RADIATOR SIDE →</text>
  <!-- REAR label -->
  <text x="700" y="820" text-anchor="middle" font-size="9" fill="#404060" font-family="Courier New">← REAR · FIREWALL · CVT TRANSMISSION →</text>

  <!-- ENGINE BOX HOUSING -->
  <rect x="200" y="120" width="860" height="620" rx="16" fill="#010a02" stroke="#39ff14" stroke-width="2.5" filter="url(#fg-g)"/>
  <ellipse cx="630" cy="430" rx="320" ry="180" fill="url(#fg-eng)" class="a-glow"/>
  <text x="630" y="144" text-anchor="middle" font-size="11" fill="#39ff14" font-family="Courier New" font-weight="700">SEALED OIL BATH ENGINE BOX — EN-GJL-250 GREY IRON</text>
  <text x="630" y="159" text-anchor="middle" font-size="8.5" fill="#004020" font-family="Courier New">860mm × 620mm · PAO ISO-68 oil bath · all internals submerged · drain port bottom</text>

  <!-- OIL BATH FILL INDICATOR -->
  <rect x="210" y="680" width="840" height="50" rx="6" fill="#001808" stroke="#40e0d0" stroke-width="1" opacity=".5"/>
  <text x="630" y="710" text-anchor="middle" font-size="9" fill="#40e0d0" font-family="Courier New">OIL BATH — PAO ISO-68 · ALL SHAFTS · CYLINDERS · WORM · HELICAL GEARS · CHAIN FULLY SUBMERGED</text>

  <!-- ═══ WORM SPINE DRIVESHAFT — CENTER RUNNING FRONT TO BACK ═══ -->
  <!-- Main shaft body -->
  <rect x="590" y="110" width="80" height="650" rx="8" fill="#1a0e00" stroke="#c9a84c" stroke-width="3" filter="url(#fg-g)"/>
  <!-- Worm thread sections animated -->
  <!-- Worm section 1 (top cylinder) -->
  <rect x="585" y="230" width="90" height="60" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="588" y1="240" x2="672" y2="240" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm"/>
  <line x1="588" y1="252" x2="672" y2="252" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.2s"/>
  <line x1="588" y1="264" x2="672" y2="264" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.4s"/>
  <line x1="588" y1="276" x2="672" y2="276" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.6s"/>
  <text x="630" y="302" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 1</text>
  <!-- Worm section 2 (middle cylinder) -->
  <rect x="585" y="400" width="90" height="60" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="588" y1="410" x2="672" y2="410" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.1s"/>
  <line x1="588" y1="422" x2="672" y2="422" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.3s"/>
  <line x1="588" y1="434" x2="672" y2="434" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.5s"/>
  <line x1="588" y1="446" x2="672" y2="446" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.7s"/>
  <text x="630" y="472" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 2</text>
  <!-- Worm section 3 (bottom cylinder) -->
  <rect x="585" y="570" width="90" height="60" rx="4" fill="#2a1800" stroke="#c9a84c" stroke-width="2"/>
  <line x1="588" y1="580" x2="672" y2="580" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.15s"/>
  <line x1="588" y1="592" x2="672" y2="592" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.35s"/>
  <line x1="588" y1="604" x2="672" y2="604" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.55s"/>
  <line x1="588" y1="616" x2="672" y2="616" stroke="#c9a84c" stroke-width="2.5" stroke-dasharray="10,5" class="a-worm" style="animation-delay:.75s"/>
  <text x="630" y="642" text-anchor="middle" font-size="8" fill="#c9a84c" font-family="Courier New">WORM 3</text>
  <!-- Driveshaft label -->
  <text x="630" y="200" text-anchor="middle" font-size="9.5" fill="#c9a84c" font-family="Courier New" font-weight="700">HIGH-LEAD</text>
  <text x="630" y="214" text-anchor="middle" font-size="9.5" fill="#c9a84c" font-family="Courier New" font-weight="700">WORM SPINE</text>
  <text x="630" y="228" text-anchor="middle" font-size="8" fill="#604000" font-family="Courier New">∅60mm · 4140 steel</text>

