  <tr><td style="color:var(--aegis)">Water hammer risk</td><td class="warn">Medium — no trap</td><td class="warn">Medium — no trap</td><td class="pass">Eliminated — steam trap</td><td class="pass">New safety — Phase 23</td></tr>
