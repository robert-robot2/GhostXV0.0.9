                    <text x="648" y="210" fill="#4aff90" font-size="11">regen</text>
                </svg>
            </div>
        </section>
    </div>

    <!-- CALCULATOR -->
    <div id="calculator">
        <section class="se-section">
            <div class="se-section-sub">Live Calculator</div>
            <h2 class="se-section-title">Power budget &amp; torque estimator</h2>
            <p class="se-section-lead">
                Adjust the parameters below to update the illustrative model in real time.
            </p>

            <div class="se-calc">
                <div class="se-slider-row">
                    <label>Steam pressure (psi)</label>
                    <input id="p1-psiSlider" type="range" min="100" max="700" step="25" value="350">
                    <span class="val" id="p1-psiOut">350 psi</span>
                </div>
                <div class="se-slider-row">
                    <label>Cylinder bore (inches)</label>
                    <input id="p1-boreSlider" type="range" min="3" max="10" step="0.5" value="6">
                    <span class="val" id="p1-boreOut">6.0 in</span>
                </div>
                <div class="se-slider-row">
                    <label>Number of cylinders</label>
                    <input id="p1-cylSlider" type="range" min="2" max="12" step="2" value="4">
                    <span class="val" id="p1-cylOut">4 cyl</span>
                </div>
                <div class="se-slider-row">
                    <label>Vehicle weight (lb)</label>
                    <input id="p1-weightSlider" type="range" min="800" max="80000" step="100" value="1500">
                    <span class="val" id="p1-weightOut">1,500 lb</span>
                </div>
                <div class="se-slider-row">
                    <label>PWM efficiency (%)</label>
                    <input id="p1-pwmSlider" type="range" min="70" max="98" step="1" value="92">
                    <span class="val" id="p1-pwmOut">92%</span>
                </div>

                <div class="se-metrics">
                    <div class="se-metric"><div class="mn" id="p1-torque">—</div><div class="ml">estimated ft-lb torque</div></div>
                    <div class="se-metric"><div class="mn" id="p1-ratio">—</div><div class="ml">relative comparison</div></div>
                    <div class="se-metric"><div class="mn" id="p1-road">—</div><div class="ml">road load at 55 mph</div></div>
                    <div class="se-metric"><div class="mn" id="p1-net">—</div><div class="ml">est. net battery draw</div></div>
                </div>

                <h3 class="se-subheading">Torque comparison</h3>
                <div class="se-bar-wrap">
                    <div class="se-bar-label"><span>Reference diesel</span><span>2,050 ft-lb at 1,200 rpm</span></div>
                    <div class="se-bar-track"><div class="se-bar-fill" style="width:35%;background:#cc4400;">2,050 ft-lb</div></div>
                </div>
                <div class="se-bar-wrap">
                    <div class="se-bar-label"><span>Your steam model</span><span id="p1-torque-label">—</span></div>
                    <div class="se-bar-track"><div class="se-bar-fill" id="p1-torque-bar" style="width:0%;background:#4ab4ff;">—</div></div>
                </div>
            </div>
        </section>
    </div>

    <!-- IMPACT -->
    <div id="impact">
        <section class="se-section">
            <div class="se-section-sub">Ecosystem &amp; Resource Impact</div>
            <h2 class="se-section-title">Oil vs water — system-level comparison</h2>
            <p class="se-section-lead">
                Water can serve as the working fluid in a closed steam cycle. However, replacing fossil fuels
                with electrically generated heat does not automatically make the complete system zero-emission;
                lifecycle emissions depend on the electricity source and equipment.
            </p>

            <div class="se-table-wrap">
                <table class="se-table">
                    <thead>
                        <tr><th>Factor</th><th>Combustion system</th><th>Steam-electric concept</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Working fluid</td><td class="bad">Fuel combustion products</td><td class="good">Water / steam</td></tr>
                        <tr><td>Tailpipe combustion CO₂</td><td class="bad">Produced during fuel combustion</td><td class="good">No combustion at vehicle point of use</td></tr>
                        <tr><td>Electricity requirement</td><td>Usually not the primary energy source</td><td class="good">Central to the proposed architecture</td></tr>
                        <tr><td>Spill risk</td><td class="bad">Fuel can be flammable and environmentally damaging</td><td class="good">Water itself is non-flammable</td></tr>
                        <tr><td>Pressure risk</td><td>Engine and fuel systems have different hazards</td><td class="bad">High-pressure steam requires rigorous engineering</td></tr>
                        <tr><td>Energy source</td><td>Chemical fuel</td><td>Electricity converted to thermal energy</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- SAFETY -->
    <div class="se-section-full" id="safety">
        <section class="se-section">
            <div class="se-section-sub">Safety Design</div>
            <h2 class="se-section-title">Pressure protection architecture</h2>
            <p class="se-section-lead">
                High-pressure steam systems require multiple independent layers of protection.
                The following is a conceptual architecture only; real pressure vessels and steam systems
                require engineering, testing, certified components, and applicable regulatory approval.
            </p>

            <div class="se-safety-grid">
                <div class="se-safety-item"><h4>Layer 1 — Control</h4><p>The controller regulates heat input and operating conditions. Independent monitoring should prevent operation outside defined limits.</p></div>
                <div class="se-safety-item"><h4>Layer 2 — Pressure Relief</h4><p>A properly rated pressure relief device provides an independent mechanical path for pressure protection.</p></div>
                <div class="se-safety-item"><h4>Layer 3 — Independent Protection</h4><p>Additional independent protection can be used where required by the applicable pressure-vessel engineering standard.</p></div>
                <div class="se-safety-item"><h4>Emergency Shutdown</h4><p>A real vehicle would require redundant shutdown controls, temperature monitoring, pressure monitoring, isolation, containment, and emergency procedures.</p></div>
            </div>

            <div style="margin-top:2.5rem;">
                <div class="se-section-sub">Historical Precedent</div>
                <h3 class="se-section-title se-small-title">Steam technology has a long engineering history</h3>
                <div class="se-timeline" style="margin-top:1.5rem;">
                    <div class="se-tl-item"><h4>18th Century — Steam Engines</h4><p>Practical steam engines demonstrated that pressure, expansion, pistons, and crank mechanisms could convert thermal energy into mechanical work.</p></div>
                    <div class="se-tl-item"><h4>19th Century — Rankine Cycle</h4><p>The Rankine cycle provided a formal thermodynamic framework for vapor power systems.</p></div>
                    <div class="se-tl-item"><h4>Early 20th Century — Steam Automobiles</h4><p>Steam-powered automobiles demonstrated that compact steam propulsion was technically possible, although practical limitations affected their adoption.</p></div>
                    <div class="se-tl-item"><h4>Modern Era — Electric Control</h4><p>Modern power electronics, sensors, generators, electric motors, and control systems provide capabilities that were unavailable to early steam vehicles.</p></div>
                </div>
            </div>
        </section>
    </div>

    <!-- FOOTER -->
    <footer class="se-footer">
        <p>Steam-Electric Vehicle Concept — experimental system architecture.</p>
        <p style="margin-top:.5rem;">Concept calculations are illustrative and should not be treated as certified vehicle, pressure-vessel, or safety specifications.</p>
    </footer>

</div>

@* Phase 1 calculator script *@
<script>
    (function() {
        function recalcP1() {
            var psi = +document.getElementById('p1-psiSlider').value;
            var bore = +document.getElementById('p1-boreSlider').value;
            var cyl = +document.getElementById('p1-cylSlider').value;
            var weight = +document.getElementById('p1-weightSlider').value;
            var pwm = +document.getElementById('p1-pwmSlider').value / 100;

            document.getElementById('p1-psiOut').textContent = psi + ' psi';
            document.getElementById('p1-boreOut').textContent = bore.toFixed(1) + ' in';
            document.getElementById('p1-cylOut').textContent = cyl + ' cyl';
            document.getElementById('p1-weightOut').textContent = weight.toLocaleString() + ' lb';
            document.getElementById('p1-pwmOut').textContent = Math.round(pwm * 100) + '%';

            var stroke = bore * 1.2;
            var area = Math.PI * Math.pow(bore / 2, 2);
            var force = psi * area;
            var torque = Math.round((force * (stroke / 24) / 12) * cyl * 0.72);

            var wKg = weight * 0.453592;
            var spd = 55 * 0.44704;
            var aero = 0.5 * 1.225 * 0.28 * 2.0 * spd * spd;
            var roll = 0.015 * wKg * 9.81;
            var road = Math.round((aero + roll) * spd);

            var steam = road / 0.35;
            var heat = steam / pwm;
            var gen = steam * 0.82 * 0.40;
            var regen = road * 0.18;
            var net = Math.max(0, Math.round(heat - gen - regen));

            var ratio = (torque / 2050).toFixed(1);
            var barW = Math.min(95, Math.round((torque / 6000) * 95));

            document.getElementById('p1-torque').textContent = torque.toLocaleString();
            document.getElementById('p1-ratio').textContent = ratio + '×';
            document.getElementById('p1-road').textContent = road.toLocaleString() + ' W';
            document.getElementById('p1-net').textContent = net.toLocaleString() + ' W';
            document.getElementById('p1-torque-label').textContent = torque.toLocaleString() + ' ft-lb';
            document.getElementById('p1-torque-bar').style.width = barW + '%';
            document.getElementById('p1-torque-bar').textContent = torque.toLocaleString() + ' ft-lb';
        }

        ['p1-psiSlider', 'p1-boreSlider', 'p1-cylSlider', 'p1-weightSlider', 'p1-pwmSlider'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('input', recalcP1);
        });

        recalcP1();
    })();
</script>

