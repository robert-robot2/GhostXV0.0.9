                    <text x="545" y="224" text-anchor="middle" fill="#aa88ff" font-size="13" font-weight="600">Generator</text>
                    <text x="545" y="242" text-anchor="middle" fill="#5a4a8a" font-size="11">Shaft → electrical</text>

                    <!-- Cylinders → Generator -->
                    <line x1="400" y1="260" x2="478" y2="230" stroke="#aa88ff" stroke-width="2" fill="none" marker-end="url(#p1sarr)" />
                    <text x="442" y="238" text-anchor="middle" fill="#aa88ff" font-size="11">shaft</text>

                    <!-- Electric Motor -->
                    <rect x="480" y="320" width="130" height="56" rx="8" fill="#0a0a28" stroke="#aa88ff" stroke-width="1" />
                    <text x="545" y="344" text-anchor="middle" fill="#aa88ff" font-size="13" font-weight="600">E-Motor</text>
                    <text x="545" y="362" text-anchor="middle" fill="#5a4a8a" font-size="11">Electric drive</text>

                    <!-- Generator → Motor -->
