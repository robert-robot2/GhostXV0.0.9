                    <text x="320" y="252" text-anchor="middle" fill="#4ab4ff" font-size="13" font-weight="600">Steam Cylinders</text>
                    <text x="320" y="272" text-anchor="middle" fill="#5a8aaa" font-size="11">Multi-cylinder</text>
                    <text x="320" y="290" text-anchor="middle" fill="#5a8aaa" font-size="11">Piston → crankshaft</text>
                    <text x="320" y="308" text-anchor="middle" fill="#ffaa00" font-size="11">High starting torque</text>

                    <!-- Steam → Cylinders -->
                    <path class="p1-steam-anim" d="M150 388 Q195 388 195 270 Q195 270 238 270" stroke="#ffaa00" stroke-width="2" fill="none" marker-end="url(#p1sarr)" />
                    <text x="185" y="350" text-anchor="middle" fill="#ffaa00" font-size="11">steam</text>

                    <!-- Condenser -->
                    <rect x="240" y="390" width="160" height="50" rx="8" fill="#001a20" stroke="#00ddaa" stroke-width="1" />
