                    <!-- Exhaust → Condenser -->
                    <line x1="320" y1="320" x2="320" y2="388" stroke="#00ddaa" stroke-width="1.5" stroke-dasharray="4 3" fill="none" marker-end="url(#p1sarr)" />
                    <text x="336" y="358" fill="#00ddaa" font-size="11">exhaust</text>

                    <!-- Condenser → Tank -->
                    <path d="M240 415 Q200 415 200 278 Q200 278 150 278" stroke="#00ddaa" stroke-width="1.5" stroke-dasharray="3 4" fill="none" marker-end="url(#p1sarr)" />
