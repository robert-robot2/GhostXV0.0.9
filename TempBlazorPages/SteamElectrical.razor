@page "/SteamElectrical"
@implements IDisposable

<PageTitle>Steam-Electric Concept | Clean Energy Design</PageTitle>

<!-- =====================================================
     PHASE TAB SHELL
     To add a new phase:
       1. Create Pages/SteamPhaseN.razor
       2. Add one entry to the _phases list below (in code section)
     That's it. No other changes needed.
     ===================================================== -->

<div class="se-shell">

    <!-- TOP TAB BAR -->
    <div class="se-tabbar-wrap">
        <button class="se-tab-arrow" @onclick="ScrollTabsLeft" aria-label="Scroll left">&#8249;</button>

        <div class="se-tabbar" id="se-tabbar">
            @foreach (var phase in _phases)
            {
                <button class="se-tab @(phase.Id == _activeId ? "se-tab--active" : "")"
                        @onclick="() => SetPhase(phase.Id)">
                    <span class="se-tab-num">@phase.Label</span>
                    <span class="se-tab-name">@phase.Name</span>
                </button>
            }
        </div>

        <button class="se-tab-arrow" @onclick="ScrollTabsRight" aria-label="Scroll right">&#8250;</button>
    </div>

    <!-- PHASE CONTENT AREA -->
    <div class="se-phase-content">
        @switch (_activeId)
        {
            case "phase1":
                <SteamPhase1 />
                break;
            case "phase2":
                <SteamPhase2 />
                break;

         
             case "phase3":            
                 <SteamPhase3 />       
                break;   
                
                case "phase4":
                <SteamPhase4 />
                break;
            case "phase5":
                <SteamPhase5 />
                break;
            case "phase6":
                <SteamPhase6 />
                break;
            case "phase7":
                <SteamPhase7 />
                break;
            case "phase8":
                <SteamPhase8 />
                break;
            case "phase9":
                <SteamPhase9 />
                break;
            case "phase10":
                <SteamPhase10 />
                break;
            case "phase11":
                <SteamPhase11 />
                break;
            case "phase12":
                <SteamPhase12 />
                break;
            case "phase13":
                <SteamPhase13 />
                break;
            case "phase14":
                <SteamPhase14 />
                break;
            case "phase15":
                <SteamPhase15 />
                break;
            case "phase16":
                <SteamPhase16 />
                break;
            case "phase17":
                <SteamPhase17 />
                break;
            case "phase18":
                <SteamPhase18 />
                break;
            case "phase19":
                <SteamPhase19 />
                break;
            case "phase20":
                <SteamPhase20 />
                break;
            case "phase21":
                <SteamPhase21 />
                break;
            case "phase22":
                <SteamPhase22 />
                break;
            case "phase23":
                <SteamPhase23 />
                break;
            case "phase24":
                <SteamPhase24 />
                break;


            default:
                <div class="se-coming-soon">
                    <div class="se-cs-icon">🔧</div>
                    <h2>Phase Coming Soon</h2>
                    <p>This phase is still being engineered. Check back later.</p>
                </div>
                break;
        }
    </div>

</div>

@* ── JS for tab bar scroll ── *@
<script>
    window.seScrollTabs = function (dir) {
        const bar = document.getElementById('se-tabbar');
        if (bar) bar.scrollBy({ left: dir * 200, behavior: 'smooth' });
    };
</script>


<style>
    /* ============================================================
       SHELL LAYOUT
       ============================================================ */
    .se-shell {
        min-height: 100vh;
        background: #0d0f14;
        color: #e8e8e8;
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        flex-direction: column;
    }

    /* ============================================================
       TAB BAR
       ============================================================ */
    .se-tabbar-wrap {
        position: sticky;
        top: 0;
        z-index: 200;
        display: flex;
        align-items: stretch;
        background: rgba(10, 12, 20, 0.97);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #1e3050;
        box-shadow: 0 2px 20px rgba(0,0,0,.5);
        height: 60px;
    }

    .se-tab-arrow {
        flex: 0 0 36px;
        background: transparent;
        border: none;
        color: #4ab4ff;
        font-size: 1.6rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: background .2s;
        border-right: 1px solid #1e3050;
    }

    .se-tab-arrow:last-child {
        border-right: none;
        border-left: 1px solid #1e3050;
    }

    .se-tab-arrow:hover {
        background: rgba(74,180,255,.08);
    }

    .se-tabbar {
        flex: 1;
        display: flex;
        align-items: stretch;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        gap: 2px;
        padding: 0 6px;
    }

    .se-tabbar::-webkit-scrollbar { display: none; }

    .se-tab {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        padding: 0 20px;
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
        min-width: 120px;
    }

    .se-tab:hover {
        background: rgba(74,180,255,.06);
        border-bottom-color: rgba(74,180,255,.3);
    }

    .se-tab--active {
        background: rgba(74,180,255,.10);
        border-bottom-color: #4ab4ff;
    }

    .se-tab-num {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #4ab4ff;
    }

    .se-tab-name {
        font-size: 11px;
        color: #9ab;
        max-width: 130px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .se-tab--active .se-tab-name {
        color: #fff;
    }

    /* ============================================================
       CONTENT AREA
       ============================================================ */
    .se-phase-content {
        flex: 1;
        overflow-x: hidden;
    }

    /* ============================================================
       COMING SOON PLACEHOLDER
       ============================================================ */
    .se-coming-soon {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        gap: 1rem;
        color: #9ab;
    }

    .se-cs-icon { font-size: 3rem; }

    .se-coming-soon h2 {
        font-size: 1.5rem;
        color: #4ab4ff;
        margin: 0;
    }

    .se-coming-soon p {
        font-size: 14px;
        color: #5a7a8a;
        margin: 0;
    }
</style>
