<!-- ENGINE OVERVIEW -->
<div class="panel active" id="panel-engine">
<div class="wrap">
  <div class="eyebrow" style="color:var(--shaft)">Diagram 1 · Engine System Overview — Phase 22</div>
  <h2 class="section-title">Phase 22 System Overview · Miasma Temple Boiler Mark 1 · CVT Drivetrain Carried Forward</h2>
  <p class="section-lead">
    Phase 22 focuses on the rear water and steam system. The Miasma Temple Boiler Mark 1 replaces the conventional flash boiler.
    All drivetrain components from Phase 21 are carried forward unchanged: 3 cylinder shafts, 3 locked diffs, amber driveshaft, CVT hydrostatic transmission, rear 2WD.
    The 17.5:1 chain to dual 2,500W alternators off cylinder shaft 1 is unchanged. The major Phase 22 changes are in the water supply, filtration, EWI injection, and boiler itself.
    10 gallon polypropylene tank replaces the 20 gallon SS tank for better rear packaging. Condenser loop still returns steam to liquid maintaining near-infinite range.
  </p>

  <div class="metrics">
    <div class="metric"><div class="val" style="color:var(--temple)">MARK 1</div><div class="lbl">Temple Boiler</div></div>
    <div class="metric"><div class="val" style="color:var(--temple)">½ Gal</div><div class="lbl">Boiler Volume</div></div>
    <div class="metric"><div class="val" style="color:var(--temple)">14cm</div><div class="lbl">Cube Outer</div></div>
    <div class="metric"><div class="val" style="color:var(--temple)">12cm</div><div class="lbl">Cube Inner</div></div>
    <div class="metric"><div class="val" style="color:var(--temple)">1cm</div><div class="lbl">Wall Thickness</div></div>
    <div class="metric"><div class="val" style="color:var(--steam)">90</div><div class="lbl">PSI Operating</div></div>
    <div class="metric"><div class="val" style="color:var(--safe)">120</div><div class="lbl">PRV Spring PSI</div></div>
    <div class="metric"><div class="val" style="color:var(--temple)">15–20s</div><div class="lbl">Cold Start Est.</div></div>
    <div class="metric"><div class="val" style="color:var(--water)">10 Gal</div><div class="lbl">Water Tank</div></div>
    <div class="metric"><div class="val" style="color:var(--inject)">300 PSI</div><div class="lbl">EWI Mist Pressure</div></div>
    <div class="metric"><div class="val" style="color:var(--cvt)">CVT</div><div class="lbl">Hydrostatic Trans</div></div>
    <div class="metric"><div class="val" style="color:var(--elec)">17.5:1</div><div class="lbl">Alt Chain</div></div>
  </div>

  <div class="legend">
    <div class="leg-item"><div class="leg-dot" style="background:var(--temple)"></div>Temple boiler — domed cube + pyramid</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--inject)"></div>High pressure EWI mist injection</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--steam)"></div>Steam lines 3/4 inch 19mm ID</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--water)"></div>10 gal water tank + filter + pump</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--shaft)"></div>Cylinder shafts + locked diffs (Phase 21)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--drive)"></div>Amber driveshaft (Phase 21)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--cvt)"></div>CVT hydrostatic → rear 2WD (Phase 21)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--elec)"></div>17.5:1 chain → dual alt (Phase 21)</div>
    <div class="leg-item"><div class="leg-dot" style="background:var(--new)"></div>New in Phase 22</div>
  </div>

  <div class="schem">
  <svg width="100%" viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="tg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#cd7f32" stop-opacity=".2"/><stop offset="100%" stop-color="#cd7f32" stop-opacity="0"/></radialGradient>
    <radialGradient id="eg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#D85A30" stop-opacity=".1"/><stop offset="100%" stop-color="#D85A30" stop-opacity="0"/></radialGradient>
    <radialGradient id="wg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#40e0d0" stop-opacity=".12"/><stop offset="100%" stop-color="#40e0d0" stop-opacity="0"/></radialGradient>
    <filter id="gf"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    <marker id="as" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#39ff14"/></marker>
    <marker id="ae" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#ffd700"/></marker>
    <marker id="ad" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#BA7517"/></marker>
    <marker id="ac" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#1D9E75"/></marker>
    <marker id="at" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#cd7f32"/></marker>
    <marker id="ai" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#00bfff"/></marker>
    <marker id="aw" markerWidth="7" markerHeight="7" refX="6" refY="2.5" orient="auto"><polygon points="0 0,7 2.5,0 5" fill="#40e0d0"/></marker>
  </defs>
