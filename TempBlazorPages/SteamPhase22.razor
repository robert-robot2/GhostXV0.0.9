    <div class="tab t-side" onclick="showTab('side',this)">↔ Side View<br><small style="font-size:7px">Full Vehicle Profile</small></div>
    <div class="tab t-top" onclick="showTab('top',this)">⬆ Top View<br><small style="font-size:7px">Rear 2WD · Temple Rear · Tank</small></div>
